import { Theme } from "theme.slint";
import {
    ViewRow, ViewRowChunk, Toolbar, LyricLine, QueueRow,
    LoginView, ViewPane, LyricsPanel, QueuePanel, PlayerBar,
} from "views.slint";
import { SettingsView } from "settings.slint";

export { ViewRow, ViewRowChunk, Toolbar, LyricLine, QueueRow }

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 36px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.accent-dim : area.has-hover ? Theme.surface-hover : transparent;

    Text {
        x: 12px;
        text: root.text;
        color: root.selected ? Theme.text : Theme.text-dim;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        height: 100%;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    title: "032player";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg;

    in-out property <bool> logged-in: false;

    // Login.
    in-out property <string> login-server;
    in-out property <string> login-api-token;
    in-out property <string> login-media-token;
    in property <bool> login-api-token-saved;
    in property <bool> login-media-token-saved;
    in-out property <string> login-error;
    in-out property <bool> login-busy;
    callback login(string, string, string);
    callback logout();

    // Settings is a page of its own; the rest are library views.
    in-out property <bool> show-settings: false;
    in property <string> server-label;

    // The library views of the sidebar.
    callback navigate(string);
    in property <string> current-view: "albums";
    in property <bool> nav-albums: true;
    in property <bool> nav-tracks: false;
    in property <bool> nav-artists: false;
    in property <bool> nav-playlists: false;
    in property <bool> nav-favorite-albums: false;
    in property <bool> nav-favorite-tracks: false;

    // The main pane.
    in property <bool> grid;
    in property <[ViewRowChunk]> rows;
    in property <[ViewRow]> lines;
    in property <string> view-title;
    in property <string> view-subtitle;
    in property <string> view-details;
    in property <image> view-cover;
    in property <bool> has-view-cover;
    in property <int> view-loaded;
    in property <int> view-total;
    in property <Toolbar> toolbar;
    in property <bool> can-play;
    in property <bool> shuffle-all-visible;
    in property <bool> load-failed;
    in property <bool> editable;
    callback layout-changed(int, length);
    callback row-clicked(int);
    callback row-play(int);
    // (index, true: play next / false: add to the end)
    callback row-enqueue(int, bool);
    callback row-favorite(int, bool);
    callback row-remove(int);
    callback play-all();
    callback enqueue-all(bool);
    callback shuffle-all();
    callback sort-picked(int);
    callback direction-toggled();
    callback search-submitted(string);
    callback year-range(int, int);
    callback favorite-toggled(bool);
    callback load-more();

    // View context menu: add the whole view to the queue or to a playlist.
    callback add-view-to-playlist(int);
    // Right-click "相似歌曲" on a track row.
    callback show-similar(int);

    // Search field of the sidebar (Enter opens the search view).
    in-out property <string> search-text;
    callback search(string);

    // "Add to playlist" menu and the playlist editor of the detail page.
    in property <[string]> playlist-names;
    callback playlists-wanted();
    callback row-add-to-playlist(int, int);
    callback row-moved(int, int);
    // Playlist editor: new name / description, rename, delete, artwork.
    in-out property <bool> show-create-playlist: false;
    in-out property <string> new-playlist-name;
    callback create-playlist(string);
    callback refresh-playlists();
    // The open playlist's id (0 when no playlist is open).
    in property <int> editing-playlist: 0;
    in-out property <bool> show-rename-playlist: false;
    in-out property <string> rename-playlist-name;
    callback rename-playlist(int, string);
    callback delete-playlist(int);
    callback upload-artwork(int);
    callback delete-artwork(int);

    // Queue (play order).
    in property <[QueueRow]> queue;
    in property <int> queue-current: -1;
    in-out property <bool> show-queue: false;
    in property <bool> shuffle;
    // 0 off, 1 all, 2 one.
    in property <int> repeat;
    callback play-queue-item(int);
    callback remove-queue-item(int);
    callback clear-queue();
    callback toggle-shuffle();
    callback cycle-repeat();
    in property <bool> sleep-active;
    in property <string> sleep-label;
    callback set-sleep(int, int);

    // Now playing.
    in property <bool> has-track;
    in property <int> playing-id: -1;
    in property <string> np-title;
    in property <string> np-artist;
    in property <string> np-album;
    in property <string> np-quality;
    in property <image> np-cover;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <bool> paused: true;
    in property <bool> buffering;
    in-out property <float> volume: 100;
    callback toggle-pause();
    callback next();
    callback previous();
    callback seek(int);
    callback volume-changed(float);

    // Lyrics.
    in property <[LyricLine]> lyrics;
    in property <int> lyrics-active: -1;
    in property <bool> lyrics-synced;
    in property <string> lyrics-source;
    in-out property <bool> show-lyrics: true;
    callback show-lyrics-changed(bool);

    // Settings.
    in property <[string]> audio-devices: ["系统默认"];
    in-out property <int> audio-device-index;
    in-out property <bool> exclusive;
    in-out property <bool> output-busy;
    callback settings-opened();
    callback audio-device-selected(int);
    callback exclusive-toggled(bool);
    // Windows tray exists: closing can hide to it.
    in property <bool> tray-available;
    in-out property <bool> close-to-tray;
    callback close-to-tray-toggled(bool);

    in property <string> notice;

    if !root.logged-in: LoginView {
        server <=> root.login-server;
        api-token <=> root.login-api-token;
        media-token <=> root.login-media-token;
        api-token-saved: root.login-api-token-saved;
        media-token-saved: root.login-media-token-saved;
        error: root.login-error;
        busy: root.login-busy;
        login(s, a, m) => {
            root.login(s, a, m);
        }
    }

    if root.logged-in: VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // Sidebar.
            Rectangle {
                width: 200px;
                background: Theme.surface;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    alignment: start;
                    Text {
                        text: "032player";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                        height: 48px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.radius;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: search-box.has-focus ? Theme.accent : Theme.border;
                        search-box := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: 100%;
                            vertical-alignment: center;
                            text <=> root.search-text;
                            color: Theme.text;
                            single-line: true;
                            accepted => {
                                root.search(root.search-text);
                            }
                        }
                        if root.search-text == "": Text {
                            x: 10px;
                            text: "搜索";
                            color: Theme.text-faint;
                            font-size: 12px;
                            vertical-alignment: center;
                            height: 100%;
                        }
                    }
                    NavItem {
                        text: "专辑";
                        selected: root.nav-albums;
                        clicked => {
                            root.navigate("albums");
                        }
                    }
                    NavItem {
                        text: "曲目";
                        selected: root.nav-tracks;
                        clicked => {
                            root.navigate("tracks");
                        }
                    }
                    NavItem {
                        text: "艺人";
                        selected: root.nav-artists;
                        clicked => {
                            root.navigate("artists");
                        }
                    }
                    NavItem {
                        text: "歌单";
                        selected: root.nav-playlists;
                        clicked => {
                            root.navigate("playlists");
                        }
                    }
                    NavItem {
                        text: "收藏的专辑";
                        selected: root.nav-favorite-albums;
                        clicked => {
                            root.navigate("favorite-albums");
                        }
                    }
                    NavItem {
                        text: "收藏的曲目";
                        selected: root.nav-favorite-tracks;
                        clicked => {
                            root.navigate("favorite-tracks");
                        }
                    }
                    if root.nav-playlists: NavItem {
                        text: "＋ 新建歌单";
                        clicked => {
                            root.show-create-playlist = true;
                        }
                    }
                    NavItem {
                        text: "设置";
                        selected: root.show-settings;
                        clicked => {
                            root.show-settings = true;
                        }
                    }
                }
                Text {
                    x: 12px;
                    y: parent.height - 28px;
                    width: parent.width - 24px;
                    text: root.server-label;
                    color: Theme.text-faint;
                    font-size: 11px;
                    overflow: elide;
                }
                Text {
                    x: 12px;
                    y: parent.height - 52px;
                    text: "退出登录";
                    color: logout-area.has-hover ? Theme.text : Theme.text-dim;
                    font-size: 12px;
                    logout-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.logout();
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                if !root.show-settings: ViewPane {
                    grid: root.grid;
                    rows: root.rows;
                    lines: root.lines;
                    title: root.view-title;
                    subtitle: root.view-subtitle;
                    details: root.view-details;
                    cover: root.view-cover;
                    has-cover: root.has-view-cover;
                    loaded: root.view-loaded;
                    total: root.view-total;
                    toolbar: root.toolbar;
                    can-play: root.can-play;
                    shuffle-all-visible: root.shuffle-all-visible;
                    load-failed: root.load-failed;
                    editable: root.editable;
                    layout-changed(n, size) => {
                        root.layout-changed(n, size);
                    }
                    row-clicked(i) => {
                        root.row-clicked(i);
                    }
                    row-play(i) => {
                        root.row-play(i);
                    }
                    row-enqueue(i, next) => {
                        root.row-enqueue(i, next);
                    }
                    row-favorite(i, on) => {
                        root.row-favorite(i, on);
                    }
                    row-remove(i) => {
                        root.row-remove(i);
                    }
                    row-add-to-playlist(i, playlist) => {
                        root.row-add-to-playlist(i, playlist);
                    }
                    row-moved(from, to) => {
                        root.row-moved(from, to);
                    }
                    row-similar(i) => {
                        root.show-similar(i);
                    }
                    playlist-names: root.playlist-names;
                    play-all => {
                        root.play-all();
                    }
                    shuffle-all => {
                        root.shuffle-all();
                    }
                    enqueue-all(next) => {
                        root.enqueue-all(next);
                    }
                    sort-picked(i) => {
                        root.sort-picked(i);
                    }
                    direction-toggled => {
                        root.direction-toggled();
                    }
                    search-submitted(text) => {
                        root.search-submitted(text);
                    }
                    year-range(from, to) => {
                        root.year-range(from, to);
                    }
                    favorite-toggled(on) => {
                        root.favorite-toggled(on);
                    }
                    load-more => {
                        root.load-more();
                    }
                }
                // Playlist editor actions.
                if root.editable && root.editing-playlist > 0: Rectangle {
                    y: parent.height - 56px;
                    height: 56px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 32px;
                        padding-right: 32px;
                        spacing: 16px;
                        alignment: start;
                        Text {
                            text: "歌单";
                            color: Theme.text-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        NavItem {
                            width: 88px;
                            text: "改名";
                            clicked => {
                                root.show-rename-playlist = true;
                            }
                        }
                        NavItem {
                            width: 88px;
                            text: "换封面";
                            clicked => {
                                root.upload-artwork(root.editing-playlist);
                            }
                        }
                        NavItem {
                            width: 112px;
                            text: "删除封面";
                            clicked => {
                                root.delete-artwork(root.editing-playlist);
                            }
                        }
                        NavItem {
                            width: 88px;
                            text: "删除歌单";
                            clicked => {
                                root.delete-playlist(root.editing-playlist);
                            }
                        }
                    }
                }
                if root.show-settings: SettingsView {
                    devices: root.audio-devices;
                    device-index <=> root.audio-device-index;
                    exclusive <=> root.exclusive;
                    output-busy: root.output-busy;
                    opened => {
                        root.settings-opened();
                    }
                    device-selected(i) => {
                        root.output-busy = true;
                        root.audio-device-selected(i);
                    }
                    exclusive-toggled(on) => {
                        root.output-busy = true;
                        root.exclusive-toggled(on);
                    }
                    tray-available: root.tray-available;
                    close-to-tray <=> root.close-to-tray;
                    close-to-tray-toggled(on) => {
                        root.close-to-tray-toggled(on);
                    }
                }
            }

            if root.show-queue: QueuePanel {
                width: 320px;
                rows: root.queue;
                current: root.queue-current;
                play(uid) => {
                    root.play-queue-item(uid);
                }
                remove(uid) => {
                    root.remove-queue-item(uid);
                }
                clear => {
                    root.clear-queue();
                }
            }

            if root.show-lyrics && !root.show-queue: LyricsPanel {
                width: 320px;
                lines: root.lyrics;
                active: root.lyrics-active;
                synced: root.lyrics-synced;
                source: root.lyrics-source;
            }
        }

        PlayerBar {
            has-track: root.has-track;
            title: root.np-title;
            artist: root.np-artist;
            album: root.np-album;
            quality: root.np-quality;
            cover: root.np-cover;
            position-ms: root.position-ms;
            duration-ms: root.duration-ms;
            position-text: root.position-text;
            duration-text: root.duration-text;
            paused: root.paused;
            buffering: root.buffering;
            volume: root.volume;
            lyrics-open: root.show-lyrics && !root.show-queue;
            queue-open: root.show-queue;
            shuffle: root.shuffle;
            repeat: root.repeat;
            sleep-active: root.sleep-active;
            sleep-label: root.sleep-label;
            set-sleep(mode, minutes) => {
                root.set-sleep(mode, minutes);
            }
            toggle-queue => {
                root.show-queue = !root.show-queue;
            }
            toggle-shuffle => {
                root.toggle-shuffle();
            }
            cycle-repeat => {
                root.cycle-repeat();
            }
            toggle-pause => {
                root.toggle-pause();
            }
            next => {
                root.next();
            }
            previous => {
                root.previous();
            }
            seek(ms) => {
                root.seek(ms);
            }
            volume-changed(v) => {
                root.volume = v;
                root.volume-changed(v);
            }
            toggle-lyrics => {
                if root.show-queue {
                    // The queue covers the lyrics: switch to them.
                    root.show-queue = false;
                    if !root.show-lyrics {
                        root.show-lyrics = true;
                        root.show-lyrics-changed(true);
                    }
                } else {
                    root.show-lyrics = !root.show-lyrics;
                    root.show-lyrics-changed(root.show-lyrics);
                }
            }
        }
    }

    // Playlist list: a "new playlist" button in the sidebar area.
    // (Rendered inside the logged-in layout above.)

    // New playlist / rename dialogs.
    if root.show-create-playlist: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;
        dialog-area := TouchArea {
            clicked => {
                root.show-create-playlist = false;
            }
        }
        Rectangle {
            width: 360px;
            height: create-form.preferred-height + 48px;
            background: Theme.raised;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            create-form := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "新建歌单";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                Rectangle {
                    height: 36px;
                    border-radius: Theme.radius;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: name-input.has-focus ? Theme.accent : Theme.border;
                    name-input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        vertical-alignment: center;
                        text <=> root.new-playlist-name;
                        color: Theme.text;
                        single-line: true;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    NavItem {
                        width: 64px;
                        text: "取消";
                        clicked => {
                            root.show-create-playlist = false;
                        }
                    }
                    Rectangle {
                        width: 88px;
                        height: 32px;
                        border-radius: Theme.radius;
                        background: Theme.accent;
                        Text {
                            text: "创建";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        ok-area := TouchArea {
                            clicked => {
                                root.show-create-playlist = false;
                                root.create-playlist(root.new-playlist-name);
                                root.new-playlist-name = "";
                            }
                        }
                    }
                }
            }
        }
    }

    if root.show-rename-playlist: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;
        TouchArea {
            clicked => {
                root.show-rename-playlist = false;
            }
        }
        Rectangle {
            width: 360px;
            height: rename-form.preferred-height + 48px;
            background: Theme.raised;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            rename-form := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "歌单改名";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                }
                Rectangle {
                    height: 36px;
                    border-radius: Theme.radius;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: rename-input.has-focus ? Theme.accent : Theme.border;
                    rename-input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        vertical-alignment: center;
                        text <=> root.rename-playlist-name;
                        color: Theme.text;
                        single-line: true;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    NavItem {
                        width: 64px;
                        text: "取消";
                        clicked => {
                            root.show-rename-playlist = false;
                        }
                    }
                    Rectangle {
                        width: 88px;
                        height: 32px;
                        border-radius: Theme.radius;
                        background: Theme.accent;
                        Text {
                            text: "保存";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        TouchArea {
                            clicked => {
                                root.show-rename-playlist = false;
                                root.rename-playlist(root.editing-playlist, root.rename-playlist-name);
                            }
                        }
                    }
                }
            }
        }
    }

    // Toast.
    if root.notice != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 84px - self.height - 16px;
        width: min(560px, toast.preferred-width + 32px);
        height: toast.preferred-height + 20px;
        border-radius: Theme.radius;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.border;
        toast := Text {
            text: root.notice;
            color: Theme.text;
            wrap: word-wrap;
            width: min(528px, self.preferred-width);
        }
    }
}
