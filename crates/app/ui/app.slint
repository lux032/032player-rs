    SearchState, SearchBestMatch, SearchCompactCard, SearchPreviewTrack, SearchPage,
} from "search.slint";

export { GridId, TrackListId, DetailKind, DialogKind }
export { Fonts, Playback, CastState, CastRoomRow, RadioState, ArtistLayout }
export { TieupWork, AlbumCard, AlbumRow, TrackRow, CreditPart, LyricLine, QueueRow, PlaylistChoice, ListQuery, DetailInfo, ReleaseGroupRow, CreditRoleTab, AlbumWorkRow, WorkUseRow, PersonRow, FactRow }
export {
    Home, Lib032, LyricsSearch, HomeRow, AlbumPane, SeriesPane, NamedItem, YearBar, HomeStats,
    WorkInfo, SeriesInfo, MixTag, MixInfo, LyricsResult,
}
export { SearchState, SearchBestMatch, SearchCompactCard, SearchPreviewTrack }

component NavItem inherits Rectangle {
    in property <string> text;
    in property <IconKind> icon;
    in property <bool> selected;
    // Icon rail (narrow windows): the icon only, centered.
    in property <bool> rail;
    callback clicked();
    height: 42px;
    border-radius: 10px;
    background: root.selected ? Theme.raised : area.has-hover ? Theme.surface-hover : transparent;

    HorizontalLayout {
        padding-left: root.rail ? 0px : 12px;
        padding-right: root.rail ? 0px : 8px;
        spacing: 14px;
        alignment: root.rail ? LayoutAlignment.center : LayoutAlignment.stretch;
        Icon {
            kind: root.icon;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            color: root.selected ? Theme.accent-text : Theme.text-dim;
        }
        if !root.rail: Text {
            text: root.text;
            font-family: Fonts.family(self.text);
            color: root.selected ? Theme.text : Theme.text-dim;
            font-size: 15px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Sidebar section title ("我的媒体库", "播放列表").
component SideHeader inherits HorizontalLayout {
    in property <string> text;
    callback clicked();
    height: 48px;
    padding-left: 12px;
    padding-top: 14px;
    padding-bottom: 4px;
    spacing: 2px;
    Text {
        text: root.text;
        font-family: Fonts.family(self.text);
        color: head-area.has-hover ? Theme.text : Theme.text-faint;
        font-size: 12.5px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-stretch: 1;
        head-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
    @children
}

// Biography: three lines, then a chevron that expands the rest.
component ArtistBio inherits VerticalLayout {
    in property <string> text;
    in property <int> artist-id;
    property <bool> expanded: false;
    changed artist-id => {
        root.expanded = false;
    }
    spacing: 2px;

    Rectangle {
        clip: true;
        height: root.expanded ? measure.preferred-height : min(measure.preferred-height, line.preferred-height * 3);
        measure := Text {
            y: 0;
            width: parent.width;
            height: self.preferred-height;
            text: root.text;
            font-family: Fonts.family(self.text);
            font-size: 15px;
            color: Theme.text;
            wrap: word-wrap;
        }
    }
    line := Text {
        visible: false;
        text: "字";
        font-family: Fonts.family(self.text);
        font-size: 15px;
    }
    if measure.preferred-height > line.preferred-height * 3 + 2px: Rectangle {
        height: 32px;
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            kind: IconKind.chevron-down;
            color: chev.has-hover ? Theme.text : Theme.text-faint;
            transform-rotation: root.expanded ? 180deg : 0deg;
        }
        chev := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.expanded = !root.expanded;
            }
        }
    }
}

// Right-hand facts (type, country, counts). Empty rows are omitted
// by the caller; there is no birth-date field on the artist API.
component ArtistFacts inherits VerticalLayout {
    in property <[FactRow]> facts;
    spacing: 12px;
    alignment: start;
    for f in root.facts: HorizontalLayout {
        height: 22px;
        spacing: 20px;
        Text {
            text: f.label;
            font-family: Fonts.family(self.text);
            font-size: 14px;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: f.value;
            font-family: Fonts.family(self.text);
            font-size: 14px;
            color: Theme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

component TrackPager inherits HorizontalLayout {
    in property <int> total;
    in-out property <int> page: 0;
    out property <int> first: root.page * 10;
    out property <int> count: max(0, min(10, root.total - root.first));
    property <int> pages: max(1, ceil(root.total / 10));
    callback turn();

    changed pages => {
        root.page = min(root.page, root.pages - 1);
    }

    alignment: end;
    spacing: 6px;
    if root.pages > 1: GhostButton {
        text: "上一页";
        y: (parent.height - self.height) / 2;
        enabled: root.page > 0;
        clicked => {
            root.page -= 1;
            root.turn();
        }
    }
    if root.pages > 1: Text {
        text: (root.page + 1) + " / " + root.pages;
        color: Theme.text-dim;
        font-size: 13px;
        vertical-alignment: center;
    }
    if root.pages > 1: GhostButton {
        text: "下一页";
        y: (parent.height - self.height) / 2;
        enabled: root.page + 1 < root.pages;
        clicked => {
            root.page += 1;
            root.turn();
        }
    }
}

// Paged artist track section, with optional backstage role tabs.
component ArtistTracksSection inherits VerticalLayout {
    in property <string> title: "幕后参与曲目";
    in property <int> artist-id;
    in property <[CreditRoleTab]> roles;
    in property <string> active-role;
    in property <[TrackRow]> tracks;
    in property <int> playing-id;
    in property <[PlaylistChoice]> playlists;
    in property <length> flex;
    callback role-selected(string);
    callback play-all(bool);
    callback track-action(string, int, int);

    changed artist-id => {
        pager.page = 0;
    }
    changed active-role => {
        pager.page = 0;
    }

    HorizontalLayout {
        padding-left: Shell.pad;
        padding-right: Shell.pad;
        height: 52px;
        spacing: 10px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Shell.tier == 2 ? 26px : 22px;
            font-weight: 780;
            vertical-alignment: center;
        }
        Text {
            text: root.tracks.length;
            font-family: Fonts.family(self.text);
            color: Theme.text-faint;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        pager := TrackPager {
            total: root.tracks.length;
        }
        IconButton {
            kind: IconKind.play;
            size: 30px;
            icon-size: 14px;
            y: (parent.height - self.height) / 2;
            enabled: root.tracks.length > 0;
            clicked => {
                root.play-all(false);
            }
        }
        GhostButton {
            text: "随机播放";
            has-icon: true;
            icon: IconKind.shuffle;
            y: (parent.height - self.height) / 2;
            enabled: root.tracks.length > 0;
            clicked => {
                root.play-all(true);
            }
        }
    }

    if root.roles.length > 0: HorizontalLayout {
        padding-left: Shell.pad;
        padding-right: Shell.pad;
        padding-bottom: 10px;
        spacing: 8px;
        alignment: start;
        for r in root.roles: Tab {
            text: r.label + " (" + r.count + ")";
            selected: r.key == root.active-role;
            clicked => {
                root.role-selected(r.key);
            }
        }
    }

    for row[i] in pager.count: TrackRowView {
        track: root.tracks[pager.first + i];
        mode: 0;
        playing: self.track.id == root.playing-id;
        playlists: root.playlists;
        title-w: root.flex * 0.42;
        artist-w: root.flex * 0.24;
        album-w: root.flex * 0.34;
        action(what, arg) => {
            root.track-action(what, self.track.index, arg);
        }
    }
}

export component AppWindow inherits Window {
    title: "032player";
    icon: @image-url("../assets/icon.png");
    no-frame: true;
    resize-border-width: (root.window-maximized || root.disable-client-resize) ? 0px : 4px;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.chrome;
    // Electron body text (Mantine `md`); fonts: `src/fonts.rs`.
    default-font-size: 14px;
    default-font-family: "Noto Sans SC";

    // Integrated window chassis state (synced from winit events in `window_chrome.rs`).
    in-out property <bool> window-active: true;
    in-out property <bool> window-maximized: false;
    // Disabled on platforms whose winit backend does not support drag_resize_window (macOS).
    in-out property <bool> disable-client-resize: false;
    property <length> resize-inset: (root.window-maximized || root.disable-client-resize) ? 0px : 4px;
    out property <length> top-bar-h: 38px;
    callback window-drag();
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    function blur-search() {
        if title-bar.search-focused {
            shortcut-scope.focus();
        }
    }
    public function focus-top-search() {
        if root.logged-in && !root.full-open && root.dialog == DialogKind.none {
            title-bar.focus-search();
        }
    }

    in-out property <bool> logged-in: false;
    // True while startup restore/auto-login checks saved credentials so
    // LoginView does not flash before the main UI appears.
    in-out property <bool> login-restoring: false;
    // Shown only when startup restore takes noticeably long.
    in-out property <bool> login-restoring-hint: false;

    // Login.
    in-out property <string> login-server;
    in-out property <string> login-api-token;
    in-out property <string> login-media-token;
    in property <bool> login-api-token-saved;
    in property <bool> login-media-token-saved;
    in-out property <string> login-error;
    in-out property <bool> login-busy;
    callback login(string, string, string);
    callback logout();

    // Navigation. Pages: 0 albums, 1 tracks, 2 settings, 3 artists,
    // 4 playlists, 5 favorites, 6 search, 10 detail (see `detail.kind`),
    // 20 home, 21 works, 22 series, 23 playback history.
    // Rust keeps the history; `navigate(page, id)` opens details by id:
    // 10 album, 11 artist, 12 playlist, 13 work, 14 series, 15 daily mix.
    in property <int> page: 0;
    // The server has the 032 home / series endpoints.
    in property <bool> has-home;
    in property <bool> can-go-back;
    callback navigate(int, int);
    callback go-back();
    // Current page offsets, saved in Rust's back-history entries. Slint
    // content-y is zero at the top and negative after scrolling down.
    in-out property <length> content-scroll-y;
    in-out property <length> inspector-scroll-y;
    in property <string> server-label;
    // Sidebar footer: "host · 18,930 首".
    in property <string> server-status;
    // Binding of the 搜索曲库 shortcut ("Ctrl+K"), shown in the sidebar.
    in property <string> search-shortcut;
    // The server has /browse (sort direction, random, album year ranges).
    in property <bool> browse;

    callback card-layout-changed(GridId, int, length);
    // (grid, most cards shown; 0: all)
    callback card-limit-changed(GridId, int);
    // (grid, row): a row of a lazy grid scrolled into view.
    callback card-row-shown(GridId, int);
    // (grid, action, id, argument)
    callback card-action(GridId, string, int, int);
    // (list, action, row index, argument)
    callback track-action(TrackListId, string, int, int);
    in property <[PlaylistChoice]> playlist-choices;
    in property <[CreditPart]> artist-choices;
    callback artist-chosen(int);

    // List queries (`target`): 0 albums, 1 tracks, 2 artists, 3 playlists,
    // 4 favorite albums, 5 favorite tracks, 6 favorite artists.
    callback query-changed(int, ListQuery);
    callback clear-filter(int);
    in-out property <ListQuery> q-albums;
    in-out property <ListQuery> q-tracks;
    in-out property <ListQuery> q-artists;
    in-out property <ListQuery> q-all-artists;
    in-out property <ListQuery> q-playlists;
    in-out property <ListQuery> q-fav-albums;
    in-out property <ListQuery> q-fav-tracks;
    in-out property <ListQuery> q-fav-artists;
    in property <[string]> album-sorts;
    in property <[bool]> album-sort-desc;
    in property <[string]> track-sorts;
    in property <[bool]> track-sort-desc;
    in property <[string]> artist-sorts;
    in property <[bool]> artist-sort-desc;
    in property <[string]> playlist-sorts;
    in property <[bool]> playlist-sort-desc;
    // Artist filter chips ("艺人：X").
    in property <string> album-filter;
    in property <string> track-filter;

    // Albums.
    in property <[AlbumRow]> album-rows;
    in property <int> album-loaded;
    in property <int> album-total;
    in property <bool> albums-loading;

    // Tracks.
    in property <[TrackRow]> tracks;
    in property <int> track-total;
    in property <bool> tracks-loading;
    callback shuffle-all();
    // Play a whole track list in order, or shuffled.
    callback play-list(TrackListId, bool);

    // Artists.
    in property <[AlbumRow]> artist-rows;
    in property <int> artist-total;
    in property <bool> artists-loading;

    // Playlists.
    in property <[AlbumRow]> playlist-rows;
    in property <int> playlist-count;
    callback new-playlist();
    // Left sidebar width (dragged by its right edge, saved on release).
    in-out property <length> sidebar-width: 248px;
    callback sidebar-resized();
    in property <string> app-version;
    in property <string> update-version;
    callback open-update();
    callback open-logs();
    // Sidebar playlists: name, "20 首 · 1 小时 14 分", cover.
    in property <[NamedItem]> side-playlists;

    // Favorites: tab 0 tracks, 1 albums, 2 artists.
    in-out property <int> fav-tab: 0;
    in property <[TrackRow]> fav-tracks;
    in property <[AlbumRow]> fav-album-rows;
    in property <[AlbumRow]> fav-artist-rows;
    in property <int> fav-album-count;
    in property <int> fav-artist-count;
    in property <bool> fav-loading;

    // Search: single-category virtualized models (overview state lives in SearchState).
    in property <[TrackRow]> search-tracks;
    in property <[AlbumRow]> search-album-rows;
    in property <[AlbumRow]> search-artist-rows;
    in property <[AlbumRow]> search-composer-rows;

    // Detail page.
    in property <DetailInfo> detail;
    in property <image> detail-cover;
    in property <bool> detail-loading;
    in property <bool> album-multi-disc;
    in property <[TrackRow]> detail-tracks;
    // Album page: linked works, release / media facts, people, review.
    in property <[AlbumWorkRow]> album-works;
    in property <[FactRow]> album-release;
    in property <[PersonRow]> album-people;
    in property <[FactRow]> album-media;
    in property <string> album-review;
    // Artist page: releases grouped like the 032 server, the biography.
    in property <[ReleaseGroupRow]> artist-groups;
    // "收藏的歌曲" of the artist (track list 12).
    in property <[TrackRow]> artist-favs;
    // Backstage credited tracks of the artist (track list 14).
    in property <[CreditRoleTab]> artist-credit-roles;
    in property <string> artist-credit-role;
    in property <[TrackRow]> artist-credits;
    in property <bool> artist-pure-credit;
    in property <string> artist-credit-summary;
    callback artist-credit-role-changed(string);
    // Role filter on page 24 ("艺术家"): "" (all), "credit", "lyricist", "composer", "arranger", "producer".
    in-out property <string> artist-dir-role: "";
    in property <bool> artist-credit-roles-supported: false;
    callback artist-dir-role-changed(string);
    in property <string> artist-about;
    // Artist info column. Only rows the server actually filled.
    in property <[FactRow]> artist-facts;
    in property <bool> playlist-artwork;
    callback detail-action(string, int);

    in property <[FactRow]> info-rows;
    in-out property <DialogKind> dialog: DialogKind.none;
    in-out property <string> dialog-name;
    in-out property <string> dialog-description;
    in-out property <string> dialog-message;
    callback dialog-confirm(string, string);

    // Queue (play order).
    in property <[QueueRow]> queue;
    in property <int> queue-current: -1;
    in property <int> queue-position: -1;
    // Entries in the whole queue (`queue` holds the search matches).
    in property <int> queue-total;
    in-out property <string> queue-search;
    callback queue-search-changed(string);
    callback save-queue();
    in property <bool> shuffle;
    // 0 off, 1 all, 2 one.
    in property <int> repeat;
    callback play-queue-item(int);
    callback remove-queue-item(int);
    callback move-queue-item(int, int);
    callback queue-row-action(string, int, int);
    callback clear-queue();
    callback toggle-shuffle();
    callback cycle-repeat();
    in property <bool> sleep-active;
    in property <string> sleep-label;
    callback set-sleep(int, int);

    // Now playing.
    in property <bool> has-track;
    in property <int> playing-id: -1;
    in property <string> np-title;
    in property <string> np-artist;
    in property <[CreditPart]> np-artists;
    in property <string> np-album;
    in property <string> np-year;
    in property <string> np-quality;
    in property <image> np-cover;
    // The current cover at `np-art-side` (right panel).
    in property <image> np-cover-large;
    in property <bool> np-favorite;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <bool> paused: true;
    in property <bool> buffering;
    in-out property <float> volume: 100;
    callback toggle-pause();
    callback next();
    callback previous();
    callback seek(int);
    callback volume-changed(float);
    callback toggle-now-favorite();
    callback open-now-album();
    callback open-now-artist(int);

    // Full-screen player: tab 0 up next, 2 lyrics. Rust loads the original
    // cover at `full-cover-side` on `full-changed`.
    in-out property <bool> full-open;
    in-out property <int> full-tab;
    in property <image> full-cover;
    in-out property <length> full-cover-side;
    callback full-changed();
    callback now-info();
    function open-full(tab: int) {
        root.full-open = true;
        root.full-tab = tab;
        root.full-changed();
    }
    public function close-full() {
        root.full-open = false;
        root.full-changed();
    }

    // Lyrics.
    in property <[LyricLine]> lyrics;
    in property <int> lyrics-active: -1;
    in property <bool> lyrics-synced;
    in property <string> lyrics-source;
    in property <bool> lyrics-translated-lines;
    in property <bool> lyrics-can-search;
    in property <bool> lyrics-can-translate;
    in property <bool> lyrics-translation-shown;
    in property <bool> lyrics-translating;
    in property <int> lyrics-offset;
    in property <int> lyrics-reset-seq: 0;
    // Right panel (settings `rightPanel`): 歌词 | 队列 tabs under the
    // current track (D2). `panel-queue`, `panel-lyrics`,
    // `panel-lyrics-first` and `panel-split` belong to the old stacked
    // layout; they are kept only to be saved back unchanged.
    in-out property <bool> panel-open: true;
    in-out property <bool> panel-queue-tab: false;
    in-out property <bool> panel-queue: true;
    in-out property <bool> panel-lyrics: true;
    in-out property <bool> panel-lyrics-first: false;
    in-out property <float> panel-split: 0.5;
    in-out property <length> panel-width: 420px;
    // Narrow windows (< 1280): the panel is an overlay, closed by default.
    in-out property <bool> overlay-open: false;

    // Breakpoints by window width (docs/UI-REDESIGN.md 外壳尺寸与断点).
    property <bool> wide: root.width >= 1700px;
    // 1280 itself is narrow, as in the final 1280x800 mockup.
    property <bool> small: root.width <= 1280px;
    property <int> tier: root.wide ? 2 : root.small ? 0 : 1;
    out property <length> bar-h: root.tier == 2 ? 92px : root.tier == 1 ? 84px : 80px;
    // The sidebar keeps its dragged width for wide windows (D6).
    property <length> nav-w: root.wide ? clamp(root.sidebar-width, 180px, 400px) : root.small ? 64px : 72px;
    property <bool> panel-docked: !root.small && root.panel-open;
    property <bool> panel-shown: root.small ? root.overlay-open : root.panel-open;
    property <length> panel-max: max(300px, min(720px, root.width * 0.4));
    property <length> panel-w: root.wide ? clamp(root.panel-width, 300px, root.panel-max) : min(372px, root.width - 80px);
    // The current cover in the panel; Rust decodes `np-cover-large` at
    // this size (`np-art-changed`, after resizing settles).
    out property <length> np-art-side: round(max(120px, min(root.wide ? root.panel-w - 48px : 248px, root.height - root.top-bar-h - root.bar-h - 470px)) / 1phx) * 1phx;
    // The detail header cover; Rust reloads it at this size.
    out property <length> detail-art-side: round(Shell.detail-art / 1phx) * 1phx;
    callback detail-art-changed();
    changed detail-art-side => {
        root.detail-art-changed();
    }
    callback np-art-changed();
    changed np-art-side => {
        art-timer.restart();
    }
    art-timer := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.running = false;
            root.np-art-changed();
        }
    }
    // Lightweight breadcrumb shown on the left side of the custom TitleBar.
    property <string> top-crumb: root.full-open
        ? (root.has-track && root.np-title != "" ? "正在播放 · " + root.np-title : "正在播放")
        : root.page == 6 ? "搜索"
        : root.page == 10
            ? ((root.detail.kind == DetailKind.album ? "专辑"
                : root.detail.kind == DetailKind.artist ? "艺人"
                : root.detail.kind == DetailKind.playlist ? "歌单"
                : root.detail.kind == DetailKind.work ? "作品"
                : root.detail.kind == DetailKind.series ? "系列"
                : root.detail.kind == DetailKind.daily-mix ? "每日推荐"
                : "其他版本")
                + (root.detail.title != "" ? " / " + root.detail.title : ""))
        : "";

    top-search-debounce := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            if !root.logged-in || root.full-open || root.dialog != DialogKind.none {
                return;
            }
            if SearchState.query-input != "" && root.page != 6 {
                root.navigate(6, 0);
            }
            if root.page == 6 {
                root.content-scroll-y = 0px;
                SearchState.search(SearchState.query-input);
            }
        }
    }

    public function toggle-right-panel() {
        if root.small {
            root.overlay-open = !root.overlay-open;
        } else {
            root.panel-open = !root.panel-open;
        }
        root.panel-changed();
    }

    // The player bar's lyrics / queue buttons and the queue shortcut: open
    // the panel on that tab, or close it when it already shows it.
    public function toggle-panel(queue: bool) {
        if root.panel-shown && root.panel-queue-tab == queue {
            if root.small {
                root.overlay-open = false;
            } else {
                root.panel-open = false;
            }
        } else {
            root.panel-queue-tab = queue;
            if root.small {
                root.overlay-open = true;
            } else {
                root.panel-open = true;
            }
        }
        root.panel-changed();
    }
    // Any of the panel-* properties changed (saved by Rust).
    callback panel-changed();
    // search, clear, translate
    callback lyrics-tool(string);
    callback lyrics-offset-changed(int);
    callback lyrics-seek(int);
    // The daily mix the current track was queued from (-1: none).
    in property <int> playing-mix: -1;
    // Lyrics settings: translation language (0 zh-Hans, 1 zh-Hant, 2 en),
    // mode (0 bilingual, 1 translated only), auto translate.
    in-out property <int> lyrics-language;
    in-out property <int> lyrics-mode;
    in-out property <bool> lyrics-auto;
    in property <bool> lyrics-translation-available;
    callback lyrics-settings-changed();

    in property <[ShortcutRow]> shortcuts;
    in-out property <int> recording-shortcut: -1;
    changed page => {
        ContextMenuState.close();
        root.recording-shortcut = -1;
        top-search-debounce.running = false;
        if root.page == 6 && SearchState.active-query == "" && root.dialog == DialogKind.none {
            title-bar.focus-search();
        } else if root.page != 6 && title-bar.search-focused {
            shortcut-scope.focus();
        }
    }
    changed logged-in => {
        top-search-debounce.running = false;
        if !root.logged-in {
            ContextMenuState.close();
            root.blur-search();
        }
    }
    changed dialog => {
        ContextMenuState.close();
        top-search-debounce.running = false;
        if root.dialog != DialogKind.none {
            root.blur-search();
        }
    }
    changed full-open => {
        ContextMenuState.close();
        top-search-debounce.running = false;
        if root.full-open {
            root.blur-search();
        }
    }
    callback shortcut-key(KeyEvent) -> bool;
    callback capture-global-shortcut(KeyEvent) -> bool;
    callback capture-shortcut(KeyEvent) -> bool;
    callback clear-shortcut(int);
    callback reset-shortcuts();
    forward-focus: shortcut-scope;
    // Settings.
    in property <[string]> audio-devices: ["系统默认"];
    in-out property <int> audio-device-index;
    in-out property <bool> exclusive;
    in-out property <int> exclusive-mode;
    in property <int> preferred-exclusive-mode: 1;
    in property <bool> asio-available;
    in property <bool> asio-configured;
    in property <bool> asio-fallback;
    in property <string> wasapi-device-label: "系统默认";
    in property <string> asio-driver-label;
    in property <bool> asio-error;
    in property <[string]> asio-drivers;
    in-out property <int> asio-driver-index;
    in property <string> asio-status;
    in property <[string]> asio-channel-pairs;
    in-out property <int> asio-channel-pair-index;
    in-out property <bool> output-busy;
    callback settings-opened();
    callback audio-device-selected(int);
    callback exclusive-toggled(bool);
    callback exclusive-quick-toggled();
    callback exclusive-mode-selected(int);
    callback asio-driver-selected(int);
    callback asio-channel-pair-selected(int);
    callback refresh-asio-driver();
    callback open-asio-control-panel();
    // Windows tray exists: closing can hide to it.
    in property <bool> tray-available;
    in-out property <bool> close-to-tray;
    callback close-to-tray-toggled(bool);
    in-out property <bool> fade-on-pause;
    callback fade-on-pause-toggled(bool);
    in property <bool> loudness-supported;
    in property <string> loudness-summary;
    in-out property <bool> loudness-enabled;
    in-out property <int> loudness-target;
    in-out property <int> loudness-mode;
    in-out property <int> loudness-peak-mode;
    callback loudness-changed();
    // 0 follow the system, 1 032 Dark, 2 032 Light (settings `theme`).
    in-out property <int> theme-mode: 1;
    callback theme-selected(int);
    function apply-theme() {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.dark
            : root.theme-mode == 2 ? ColorScheme.light : ColorScheme.unknown;
    }
    init => {
        root.apply-theme();
        Shell.window-width = root.width;
        Shell.window-height = root.height;
    }
    changed width => {
        Shell.window-width = root.width;
    }
    changed height => {
        Shell.window-height = root.height;
    }
    changed theme-mode => {
        root.apply-theme();
    }
    in property <[string]> transcode-options: ["原始文件"];
    in-out property <int> transcode-index;
    callback transcode-selected(int);

    in property <string> notice;

    function count(n: int, unit: string) -> string {
        return n == 0 ? "" : n + " " + unit;
    }

    shortcut-scope := FocusScope {
        width: root.width;
        height: root.height;
        changed width => {
            Shell.window-width = self.width;
        }
        changed height => {
            Shell.window-height = self.height;
        }
        capture-key-pressed(e) => {
            if root.recording-shortcut >= 0 { return root.capture-shortcut(e) ? accept : reject; }
            if ContextMenuState.open && e.text == Key.Escape {
                ContextMenuState.close();
                return accept;
            }
            if root.dialog != DialogKind.none && e.text == Key.Escape {
                root.dialog = DialogKind.none;
                return accept;
            }
            if root.logged-in && root.dialog == DialogKind.none && !ContextMenuState.open && !title-bar.search-focused {
                if root.capture-global-shortcut(e) {
                    return accept;
                }
            }
            return reject;
        }
        key-pressed(e) => {
            if ContextMenuState.open {
                if e.text == Key.Escape {
                    ContextMenuState.close();
                    return accept;
                }
                return reject;
            }
            if root.dialog != DialogKind.none {
                if e.text == Key.Escape {
                    root.dialog = DialogKind.none;
                    return accept;
                }
                return reject;
            }
            if root.logged-in && root.full-open && e.text == Key.Escape {
                if !e.repeat {
                    root.close-full();
                }
                return accept;
            }
            if root.logged-in && root.page == 6 && root.can-go-back && e.text == Key.Escape {
                if !e.repeat {
                    root.go-back();
                }
                return accept;
            }
            if root.logged-in { return root.shortcut-key(e) ? accept : reject; }
            return reject;
        }

    if !root.logged-in && !root.login-restoring: Rectangle {
        x: 8px;
        y: root.top-bar-h;
        width: root.width - 16px;
        height: root.height - root.top-bar-h - 8px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.bg;
        clip: true;
        LoginView {
            width: 100%;
            height: 100%;
            server <=> root.login-server;
            api-token <=> root.login-api-token;
            media-token <=> root.login-media-token;
            api-token-saved: root.login-api-token-saved;
            media-token-saved: root.login-media-token-saved;
            error: root.login-error;
            busy: root.login-busy;
            login(s, a, m) => {
                root.login(s, a, m);
            }
        }
    }

    if !root.logged-in && root.login-restoring && root.login-restoring-hint: Rectangle {
        x: 8px;
        y: root.top-bar-h;
        width: root.width - 16px;
        height: root.height - root.top-bar-h - 8px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.bg;
        clip: true;
        Text {
            text: "正在连接服务器…";
            color: Theme.text-faint;
            font-size: 14px;
        }
    }

    if root.logged-in: VerticalLayout {
        x: 0px;
        y: root.top-bar-h;
        width: root.width;
        height: root.height - root.top-bar-h;

        HorizontalLayout {
            vertical-stretch: 1;
            min-height: 0px;
            padding-right: 8px;
            spacing: 0px;

            // Left navigation: library, playlists, and server status with the
            // settings entry at the bottom (D1). Global search lives in TitleBar.
            // Narrower than 1700px it is an icon rail (D6).
            sidebar := Rectangle {
                width: root.nav-w;
                min-height: 0px;
                background: Theme.chrome;
                clip: true;
                property <bool> rail: !root.wide;
                property <length> item-w: root.small ? 44px : 48px;
                TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            root.blur-search();
                        }
                    }
                }
                VerticalLayout {
                    padding-top: sidebar.rail ? 6px : 4px;
                    padding-bottom: 8px;
                    padding-left: sidebar.rail ? 4px : 12px;
                    padding-right: sidebar.rail ? 0px : 6px;
                    spacing: 0px;
                    side-list := Flickable {
                        vertical-stretch: 1;
                        min-height: 0px;
                        content-height: side-col.preferred-height;
                        side-col := VerticalLayout {
                            width: side-list.width;
                            alignment: start;
                            spacing: 0px;
                            if !sidebar.rail: SideHeader {
                                height: 36px;
                                padding-top: 4px;
                                text: "我的媒体库";
                            }
                            for item in [
                                { text: "主页", page: 20, icon: IconKind.home },
                                { text: "收藏", page: 5, icon: IconKind.heart-outline },
                                { text: "专辑", page: 0, icon: IconKind.disc },
                                { text: "曲目", page: 1, icon: IconKind.note },
                                { text: "专辑艺术家", page: 3, icon: IconKind.person },
                                { text: "艺术家", page: 24, icon: IconKind.people },
                                { text: "作品", page: 21, icon: IconKind.work },
                                { text: "系列", page: 22, icon: IconKind.layers },
                                { text: "播放记录", page: 23, icon: IconKind.history },
                            ]: HorizontalLayout {
                                alignment: center;
                                visible: item.page != 20 || root.has-home;
                                height: item.page != 20 || root.has-home ? 42px : 0px;
                                NavItem {
                                    width: sidebar.rail ? sidebar.item-w : sidebar.width - 18px;
                                    rail: sidebar.rail;
                                    text: item.text;
                                    icon: item.icon;
                                    selected: root.page == item.page;
                                    clicked => {
                                        root.blur-search();
                                        root.navigate(item.page, 0);
                                    }
                                }
                            }
                            if !sidebar.rail: SideHeader {
                                text: "播放列表";
                                clicked => {
                                    root.blur-search();
                                    root.navigate(4, 0);
                                }
                                IconButton {
                                    kind: IconKind.plus;
                                    size: 26px;
                                    icon-size: 16px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => {
                                        root.blur-search();
                                        root.new-playlist();
                                    }
                                }
                                IconButton {
                                    kind: IconKind.sliders;
                                    size: 26px;
                                    icon-size: 16px;
                                    y: (parent.height - self.height) / 2;
                                    active: root.page == 4;
                                    clicked => {
                                        root.blur-search();
                                        root.navigate(4, 0);
                                    }
                                }
                            }
                            if sidebar.rail: Rectangle {
                                height: 18px;
                            }
                            for p in root.side-playlists: HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: sidebar.rail ? 50px : sidebar.width - 18px;
                                    height: sidebar.rail ? 50px : 54px;
                                    border-radius: 10px;
                                    background: root.page == 10 && root.detail.kind == DetailKind.playlist && root.detail.id == p.id ? Theme.raised : p-area.has-hover ? Theme.surface-hover : transparent;
                                    HorizontalLayout {
                                        padding-left: sidebar.rail ? 4px : 12px;
                                        padding-right: sidebar.rail ? 4px : 12px;
                                        spacing: 12px;
                                        Rectangle {
                                            width: 42px;
                                            height: 42px;
                                            y: (parent.height - self.height) / 2;
                                            Rectangle {
                                                width: ArtFit.width(42px, 42px, p.cover);
                                                height: ArtFit.height(42px, 42px, p.cover);
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 6px;
                                                background: p.cover.width == 0 ? Theme.raised : transparent;
                                                clip: true;
                                                if p.cover.width == 0: Icon {
                                                    kind: IconKind.list;
                                                    width: 18px;
                                                    height: 18px;
                                                    color: Theme.text-faint;
                                                }
                                                Image {
                                                    source: p.cover;
                                                    width: 100%;
                                                    height: 100%;
                                                    image-fit: ImageFit.cover;
                                                }
                                            }
                                        }
                                        if !sidebar.rail: VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: p.title;
                                                font-family: Fonts.family(self.text);
                                                color: Theme.text;
                                                font-size: 14px;
                                                font-weight: 600;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: p.meta;
                                                font-family: Fonts.family(self.text);
                                                color: Theme.text-faint;
                                                font-size: 12.5px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    p-area := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.blur-search();
                                            root.navigate(12, p.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Server status and the settings entry.
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: sidebar.rail ? sidebar.item-w : sidebar.width - 18px;
                            height: 42px;
                            border-radius: 10px;
                            background: foot-area.has-hover || root.page == 2 ? Theme.surface-hover : transparent;
                            foot-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.blur-search();
                                    root.navigate(2, 0);
                                }
                            }
                            HorizontalLayout {
                                padding-left: sidebar.rail ? 0px : 12px;
                                padding-right: sidebar.rail ? 0px : 12px;
                                spacing: 10px;
                                alignment: sidebar.rail ? LayoutAlignment.center : LayoutAlignment.stretch;
                                if !sidebar.rail: Rectangle {
                                    width: 14px;
                                    Rectangle {
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 7px;
                                        background: Theme.ok.with-alpha(0.15);
                                    }
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: Theme.ok;
                                    }
                                }
                                if !sidebar.rail: Text {
                                    text: root.server-status;
                                    font-family: Fonts.family(self.text);
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Icon {
                                    kind: IconKind.gear;
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    color: root.page == 2 ? Theme.accent-text : foot-area.has-hover ? Theme.text : Theme.text-dim;
                                }
                            }
                        }
                    }
                }
            }

            // 8px chassis gap between sidebar and main canvas; on wide windows
            // it doubles as the sidebar resize handle (180-400px).
            Rectangle {
                width: 8px;
                background: transparent;
                if root.wide: Rectangle {
                    width: 100%;
                    height: 100%;
                    property <length> press-x;
                    Rectangle {
                        x: 3px;
                        y: 12px;
                        width: 2px;
                        height: parent.height - 24px;
                        border-radius: 1px;
                        background: side-edge.has-hover || side-edge.pressed ? Theme.accent : transparent;
                    }
                    side-edge := TouchArea {
                        mouse-cursor: col-resize;
                        pointer-event(e) => {
                            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                parent.press-x = self.mouse-x;
                            }
                            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                                root.sidebar-width = sidebar.width;
                                root.sidebar-resized();
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.sidebar-width = clamp(sidebar.width + (self.mouse-x - parent.press-x), 180px, 400px);
                            }
                        }
                    }
                }
            }

            pages := Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                TouchArea {
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            root.blur-search();
                        }
                    }
                }

                if root.page == 0: VerticalLayout {
                    PageHeader {
                        title: "专辑";
                        count: root.album-total == 0 ? "" : root.album-loaded < root.album-total ? root.album-loaded + " / " + root.album-total : root.album-total + " 张";
                        ListToolbar {
                            sort-labels: root.album-sorts;
                            sort-desc: root.album-sort-desc;
                            query: root.q-albums;
                            show-order: root.browse;
                            show-years: true;
                            filter-label: root.album-filter;
                            changed(q) => {
                                root.content-scroll-y = 0px;
                                root.q-albums = q;
                                root.query-changed(0, q);
                            }
                            clear-filter => {
                                root.content-scroll-y = 0px;
                                root.clear-filter(0);
                            }
                        }
                    }
                    CardGrid {
                        vertical-stretch: 1;
                        scroll-y <=> root.content-scroll-y;
                        rows: root.album-rows;
                        kind: 0;
                        loading: root.albums-loading;
                        empty-text: "没有专辑";
                        playlists: root.playlist-choices;
                        layout-changed(n, size) => {
                            root.card-layout-changed(GridId.albums, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(GridId.albums, what, id, arg);
                        }
                    }
                }

                if root.page == 1: VerticalLayout {
                    PageHeader {
                        title: "曲目";
                        count: root.track-total == 0 ? "" : root.tracks.length < root.track-total ? root.tracks.length + " / " + root.track-total : root.track-total + " 首";
                        ListToolbar {
                            sort-labels: root.track-sorts;
                            sort-desc: root.track-sort-desc;
                            query: root.q-tracks;
                            show-order: root.browse;
                            show-years: true;
                            filter-label: root.track-filter;
                            changed(q) => {
                                root.content-scroll-y = 0px;
                                root.q-tracks = q;
                                root.query-changed(1, q);
                            }
                            clear-filter => {
                                root.content-scroll-y = 0px;
                                root.clear-filter(1);
                            }
                            GhostButton {
                                text: "随机播放全部";
                                has-icon: true;
                                icon: IconKind.shuffle;
                                clicked => {
                                    root.shuffle-all();
                                }
                            }
                        }
                    }
                    TrackList {
                        vertical-stretch: 1;
                        scroll-y <=> root.content-scroll-y;
                        rows: root.tracks;
                        mode: 0;
                        loading: root.tracks-loading;
                        playing-id: root.playing-id;
                        playlists: root.playlist-choices;
                        action(what, i, arg) => {
                            root.track-action(TrackListId.library, what, i, arg);
                        }
                    }
                }

                // 3: album artists, 24: everyone credited (role=all).
                if root.page == 3 || root.page == 24: artists-page := VerticalLayout {
                    property <int> target: root.page == 24 ? 7 : 2;
                    changed target => {
                        root.query-changed(self.target, root.page == 24 ? root.q-all-artists : root.q-artists);
                    }
                    PageHeader {
                        title: root.page == 24 ? "艺术家" : "专辑艺术家";
                        count: root.count(root.artist-total, "位");
                        if root.page == 3: ListToolbar {
                            sort-labels: root.artist-sorts;
                            sort-desc: root.artist-sort-desc;
                            query: root.q-artists;
                            show-order: root.browse;
                            changed(q) => {
                                root.content-scroll-y = 0px;
                                root.q-artists = q;
                                root.query-changed(2, q);
                            }
                        }
                        if root.page == 24: ListToolbar {
                            sort-labels: root.artist-sorts;
                            sort-desc: root.artist-sort-desc;
                            query: root.q-all-artists;
                            show-order: root.browse;
                            changed(q) => {
                                root.content-scroll-y = 0px;
                                root.q-all-artists = q;
                                root.query-changed(7, q);
                            }
                        }
                    }
                    if root.page == 24 && root.browse && root.artist-credit-roles-supported: HorizontalLayout {
                        padding-left: Shell.pad;
                        padding-right: Shell.pad;
                        padding-bottom: 10px;
                        spacing: 8px;
                        alignment: start;
                        Tab {
                            text: "全部";
                            selected: root.artist-dir-role == "";
                            clicked => {
                                root.artist-dir-role = "";
                                root.artist-dir-role-changed("");
                            }
                        }
                        Tab {
                            text: "全部幕后";
                            selected: root.artist-dir-role == "credit";
                            clicked => {
                                root.artist-dir-role = "credit";
                                root.artist-dir-role-changed("credit");
                            }
                        }
                        Tab {
                            text: "作词";
                            selected: root.artist-dir-role == "lyricist";
                            clicked => {
                                root.artist-dir-role = "lyricist";
                                root.artist-dir-role-changed("lyricist");
                            }
                        }
                        Tab {
                            text: "作曲";
                            selected: root.artist-dir-role == "composer";
                            clicked => {
                                root.artist-dir-role = "composer";
                                root.artist-dir-role-changed("composer");
                            }
                        }
                        Tab {
                            text: "编曲";
                            selected: root.artist-dir-role == "arranger";
                            clicked => {
                                root.artist-dir-role = "arranger";
                                root.artist-dir-role-changed("arranger");
                            }
                        }
                        Tab {
                            text: "制作";
                            selected: root.artist-dir-role == "producer";
                            clicked => {
                                root.artist-dir-role = "producer";
                                root.artist-dir-role-changed("producer");
                            }
                        }
                    }
                    CardGrid {
                        vertical-stretch: 1;
                        scroll-y <=> root.content-scroll-y;
                        rows: root.artist-rows;
                        kind: 1;
                        loading: root.artists-loading;
                        empty-text: "没有艺人";
                        playlists: root.playlist-choices;
                        init => {
                            root.query-changed(artists-page.target, root.page == 24 ? root.q-all-artists : root.q-artists);
                        }
                        layout-changed(n, size) => {
                            root.card-layout-changed(GridId.artists, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(GridId.artists, what, id, arg);
                        }
                    }
                }

                if root.page == 4: VerticalLayout {
                    PageHeader {
                        title: "歌单";
                        count: root.count(root.playlist-count, "个");
                        ListToolbar {
                            sort-labels: root.playlist-sorts;
                            sort-desc: root.playlist-sort-desc;
                            query: root.q-playlists;
                            changed(q) => {
                                root.content-scroll-y = 0px;
                                root.q-playlists = q;
                                root.query-changed(3, q);
                            }
                            GhostButton {
                                text: "新建歌单";
                                has-icon: true;
                                icon: IconKind.plus;
                                clicked => {
                                    root.new-playlist();
                                }
                            }
                        }
                    }
                    CardGrid {
                        vertical-stretch: 1;
                        scroll-y <=> root.content-scroll-y;
                        rows: root.playlist-rows;
                        kind: 2;
                        empty-text: "还没有歌单";
                        layout-changed(n, size) => {
                            root.card-layout-changed(GridId.playlists, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(GridId.playlists, what, id, arg);
                        }
                    }
                }

                if root.page == 5: VerticalLayout {
                    PageHeader {
                        title: "收藏";
                        count: root.fav-tab == 0 ? root.count(root.fav-tracks.length, "首") : root.fav-tab == 1 ? root.count(root.fav-album-count, "张") : root.count(root.fav-artist-count, "位");
                        HorizontalLayout {
                            spacing: 8px;
                            Tab {
                                text: "曲目";
                                selected: root.fav-tab == 0;
                                clicked => {
                                    root.content-scroll-y = 0px;
                                    root.fav-tab = 0;
                                }
                            }
                            Tab {
                                text: "专辑";
                                selected: root.fav-tab == 1;
                                clicked => {
                                    root.content-scroll-y = 0px;
                                    root.fav-tab = 1;
                                }
                            }
                            Tab {
                                text: "艺人";
                                selected: root.fav-tab == 2;
                                clicked => {
                                    root.content-scroll-y = 0px;
                                    root.fav-tab = 2;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            // The filtered, sorted favorite tracks (list 1).
                            if root.fav-tab == 0: HorizontalLayout {
                                horizontal-stretch: 0;
                                spacing: 10px;
                                PrimaryButton {
                                    horizontal-stretch: 0;
                                    text: "播放";
                                    has-icon: true;
                                    enabled: root.fav-tracks.length > 0;
                                    clicked => {
                                        root.play-list(TrackListId.favorites, false);
                                    }
                                }
                                GhostButton {
                                    height: 40px;
                                    text: "随机播放";
                                    has-icon: true;
                                    icon: IconKind.shuffle;
                                    enabled: root.fav-tracks.length > 0;
                                    clicked => {
                                        root.play-list(TrackListId.favorites, true);
                                    }
                                }
                            }
                        }
                        if root.fav-tab == 0: ListToolbar {
                            sort-labels: root.track-sorts;
                            sort-desc: root.track-sort-desc;
                            query: root.q-fav-tracks;
                            show-years: true;
                            changed(q) => {
                                root.content-scroll-y = 0px;
                                favorites-pager.page = 0;
                                root.q-fav-tracks = q;
                                root.query-changed(5, q);
                            }
                        }
                        if root.fav-tab == 1: ListToolbar {
                            sort-labels: root.album-sorts;
                            sort-desc: root.album-sort-desc;
                            query: root.q-fav-albums;
                            show-years: true;
                            changed(q) => {
                                root.content-scroll-y = 0px;
                                root.q-fav-albums = q;
                                root.query-changed(4, q);
                            }
                        }
                        if root.fav-tab == 2: ListToolbar {
                            sort-labels: root.artist-sorts;
                            sort-desc: root.artist-sort-desc;
                            query: root.q-fav-artists;
                            show-order: root.browse;
                            changed(q) => {
                                root.content-scroll-y = 0px;
                                root.q-fav-artists = q;
                                root.query-changed(6, q);
                            }
                        }
                    }
                    favorites-pager := TrackPager {
                        visible: root.fav-tab == 0 && root.fav-tracks.length > 10;
                        height: self.visible ? 36px : 0px;
                        padding-right: Shell.pad;
                        total: root.fav-tracks.length;
                        turn => { root.content-scroll-y = 0px; }
                    }
                    if root.fav-tab == 0: TrackList {
                        vertical-stretch: 1;
                        scroll-y <=> root.content-scroll-y;
                        rows: root.fav-tracks;
                        first-row: favorites-pager.first;
                        row-count: favorites-pager.count;
                        mode: 0;
                        loading: root.fav-loading;
                        empty-text: "还没有收藏的曲目";
                        playing-id: root.playing-id;
                        playlists: root.playlist-choices;
                        init => {
                            root.query-changed(5, root.q-fav-tracks);
                        }
                        action(what, i, arg) => {
                            root.track-action(TrackListId.favorites, what, i, arg);
                        }
                    }
                    if root.fav-tab == 1: CardGrid {
                        vertical-stretch: 1;
                        scroll-y <=> root.content-scroll-y;
                        rows: root.fav-album-rows;
                        kind: 0;
                        loading: root.fav-loading;
                        empty-text: "还没有收藏的专辑";
                        playlists: root.playlist-choices;
                        init => {
                            root.query-changed(4, root.q-fav-albums);
                        }
                        layout-changed(n, size) => {
                            root.card-layout-changed(GridId.fav-albums, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(GridId.fav-albums, what, id, arg);
                        }
                    }
                    if root.fav-tab == 2: CardGrid {
                        vertical-stretch: 1;
                        scroll-y <=> root.content-scroll-y;
                        rows: root.fav-artist-rows;
                        kind: 1;
                        loading: root.fav-loading;
                        empty-text: "还没有收藏的艺人";
                        playlists: root.playlist-choices;
                        init => {
                            root.query-changed(6, root.q-fav-artists);
                        }
                        layout-changed(n, size) => {
                            root.card-layout-changed(GridId.fav-artists, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(GridId.fav-artists, what, id, arg);
                        }
                    }
                }

                if root.page == 6: SearchPage {
                    scroll-y <=> root.content-scroll-y;
                    playing-id: root.playing-id;
                    playlists: root.playlist-choices;
                    artist-rows: root.search-artist-rows;
                    album-rows: root.search-album-rows;
                    track-rows: root.search-tracks;
                    composer-rows: root.search-composer-rows;
                    card-layout-changed(g, n, size) => {
                        root.card-layout-changed(g, n, size);
                    }
                    card-action(g, what, id, arg) => {
                        root.card-action(g, what, id, arg);
                    }
                    track-action(list, what, i, arg) => {
                        root.track-action(list, what, i, arg);
                    }
                }

                // Album, playlist: header and a virtualized list.
                if root.page == 10 && (root.detail.kind == DetailKind.album || root.detail.kind == DetailKind.playlist): detail-page := VerticalLayout {
                    // Album info column (Electron: beside the tracks from
                    // the lg breakpoint); narrower pages switch with tabs.
                    property <bool> album: root.detail.kind == DetailKind.album;
                    property <bool> has-info: self.album && (root.album-works.length > 0 || root.album-release.length > 0 || root.album-people.length > 0);
                    property <bool> side: pages.width >= 1100px;
                    property <bool> info-tab;
                    property <int> detail-id: root.detail.id;
                    changed detail-id => {
                        self.info-tab = false;
                    }
                    detail-head := DetailHeader {
                        info: root.detail;
                        cover: root.detail-cover;
                        loading: root.detail-loading;
                        artwork-upload: root.playlist-artwork;
                        playlists: root.playlist-choices;
                        works: detail-page.album ? root.album-works : [];
                        facts: detail-page.album ? root.album-release : [];
                        action(what, arg) => {
                            root.detail-action(what, arg);
                        }
                    }
                    if detail-page.has-info && !detail-page.side: HorizontalLayout {
                        padding-left: Shell.pad;
                        padding-bottom: 6px;
                        spacing: 4px;
                        alignment: start;
                        Tab {
                            text: "曲目";
                            selected: !detail-page.info-tab;
                            clicked => {
                                detail-page.info-tab = false;
                            }
                        }
                        Tab {
                            text: "信息";
                            selected: detail-page.info-tab;
                            clicked => {
                                detail-page.info-tab = true;
                            }
                        }
                    }
                    // Tracks and the info column (explicit geometry: a
                    // layout would make the track columns' widths loop).
                    body := Rectangle {
                        vertical-stretch: 1;
                        property <bool> show-info: detail-page.has-info && (detail-page.side || detail-page.info-tab);
                        // Inspector 440 (340 below 1700) beside the tracks, 56 apart.
                        property <length> info-w: detail-page.side ? (Shell.tier == 2 ? 440px : 340px) + Shell.pad + 16px : self.width;
                        if !(detail-page.has-info && !detail-page.side && detail-page.info-tab): TrackList {
                            x: 0;
                            y: 0;
                            scroll-y <=> root.content-scroll-y;
                            width: body.width - (body.show-info ? body.info-w : 0px);
                            height: body.height;
                            rows: root.detail-tracks;
                            mode: root.detail.kind == DetailKind.album ? 1 : root.detail.kind == DetailKind.playlist ? 2 : 0;
                            multi-disc: root.detail.kind == DetailKind.album && root.album-multi-disc;
                            loading: root.detail-loading;
                            empty-text: root.detail.kind == DetailKind.playlist ? "歌单是空的" : "没有曲目";
                            playing-id: root.playing-id;
                            playlists: root.playlist-choices;
                            action(what, i, arg) => {
                                root.track-action(TrackListId.detail, what, i, arg);
                            }
                        }
                        if body.show-info: AlbumInspector {
                            x: body.width - body.info-w + (detail-page.side ? 16px : Shell.pad);
                            y: 0;
                            scroll-y <=> root.inspector-scroll-y;
                            width: body.info-w - (detail-page.side ? 16px : Shell.pad);
                            height: body.height;
                            works: root.album-works;
                            // The header shows the release facts when there is room.
                            release: detail-head.facts-shown ? [] : root.album-release;
                            people: root.album-people;
                            media: root.album-media;
                            review: root.album-review;
                            album-id: root.detail.id;
                            action(what, id) => {
                                root.navigate(what == "work" ? 13 : 11, id);
                            }
                        }
                    }
                }

                // Artist: one scrolling page with header, bio/facts, releases and favorites.
                if root.page == 10 && root.detail.kind == DetailKind.artist: artist-flick := Flickable {
                    content-y <=> root.content-scroll-y;
                    property <length> flex: max(0px, self.width - 2 * Shell.pad - 44px - 46px - 40px - 64px - 96px);
                    content-height: artist-page.preferred-height;
                    artist-page := VerticalLayout {
                        width: artist-flick.width;
                        alignment: start;
                        padding-bottom: 24px;
                        ArtistHeader {
                            info: root.detail;
                            cover: root.detail-cover;
                            loading: root.detail-loading;
                            playlists: root.playlist-choices;
                            favorite-count: root.artist-favs.length;
                            credit-summary: root.artist-credit-summary;
                            action(what, arg) => {
                                root.detail-action(what, arg);
                            }
                        }
                        if root.artist-about != "" || root.artist-facts.length > 0: overview := VerticalLayout {
                            property <length> content-w: max(0px, artist-flick.width - 2 * Shell.pad);
                            property <bool> side: self.content-w >= 720px && root.artist-about != "" && root.artist-facts.length > 0;
                            padding-left: Shell.pad;
                            padding-right: Shell.pad;
                            padding-top: 12px;
                            padding-bottom: 8px;
                            if overview.side: HorizontalLayout {
                                spacing: 48px;
                                ArtistBio {
                                    // Fixed width: a wrapping biography must not
                                    // feed its height back into the row width.
                                    width: max(200px, overview.content-w - 288px);
                                    horizontal-stretch: 0;
                                    text: root.artist-about;
                                    artist-id: root.detail.id;
                                }
                                ArtistFacts {
                                    width: 240px;
                                    horizontal-stretch: 0;
                                    vertical-stretch: 0;
                                    facts: root.artist-facts;
                                }
                            }
                            if !overview.side: VerticalLayout {
                                spacing: 24px;
                                if root.artist-about != "": ArtistBio {
                                    width: overview.content-w;
                                    horizontal-stretch: 0;
                                    text: root.artist-about;
                                    artist-id: root.detail.id;
                                }
                                if root.artist-facts.length > 0: ArtistFacts {
                                    width: min(320px, parent.width);
                                    facts: root.artist-facts;
                                }
                            }
                        }
                        if root.artist-pure-credit && root.artist-credit-roles.length > 0: ArtistTracksSection {
                            title: "幕后作品曲目";
                            artist-id: root.detail.id;
                            roles: root.artist-credit-roles;
                            active-role: root.artist-credit-role;
                            tracks: root.artist-credits;
                            playing-id: root.playing-id;
                            playlists: root.playlist-choices;
                            flex: artist-flick.flex;
                            role-selected(role) => {
                                root.artist-credit-role-changed(role);
                            }
                            play-all(shuffle) => {
                                root.play-list(TrackListId.artist-credits, shuffle);
                            }
                            track-action(what, idx, arg) => {
                                root.track-action(TrackListId.artist-credits, what, idx, arg);
                            }
                        }
                        for g[gi] in root.artist-groups: group := VerticalLayout {
                            HorizontalLayout {
                                padding-left: Shell.pad;
                                padding-right: Shell.pad;
                                height: 52px;
                                spacing: 10px;
                                Text {
                                    text: g.title;
                                    color: Theme.text;
                                    font-size: Shell.tier == 2 ? 26px : 22px;
                                    font-weight: 780;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: g.count;
                                    font-family: Fonts.family(self.text);
                                    color: Theme.text-faint;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                // Electron `AlbumSection`: play / next / last
                                // for every album of the group.
                                IconButton {
                                    kind: IconKind.play;
                                    size: 30px;
                                    icon-size: 14px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => {
                                        root.detail-action("group-play", gi);
                                    }
                                }
                                GhostButton {
                                    text: "下一首播放";
                                    y: (parent.height - self.height) / 2;
                                    clicked => {
                                        root.detail-action("group-next", gi);
                                    }
                                }
                                GhostButton {
                                    text: "添加到末尾";
                                    y: (parent.height - self.height) / 2;
                                    clicked => {
                                        root.detail-action("group-last", gi);
                                    }
                                }
                            }
                            CardRows {
                                width: artist-flick.width;
                                rows: g.rows;
                                kind: 0;
                                playlists: root.playlist-choices;
                                // Covers of the rows on screen, plus half a
                                // screen above and below.
                                lazy: true;
                                view-top: -artist-flick.content-y - group.y - self.y - artist-flick.height / 2;
                                view-bottom: self.view-top + artist-flick.height * 2;
                                row-shown(row) => {
                                    root.card-row-shown(g.grid, row);
                                }
                                layout-changed(n, size) => {
                                    root.card-layout-changed(g.grid, n, size);
                                }
                                action(what, id, arg) => {
                                    root.card-action(g.grid, what, id, arg);
                                }
                            }
                        }
                        if root.artist-favs.length > 0: Rectangle {
                            height: 12px;
                        }
                        if root.artist-favs.length > 0: ArtistTracksSection {
                            title: "收藏的歌曲";
                            artist-id: root.detail.id;
                            tracks: root.artist-favs;
                            playing-id: root.playing-id;
                            playlists: root.playlist-choices;
                            flex: artist-flick.flex;
                            play-all(shuffle) => {
                                root.play-list(TrackListId.artist-favorites, shuffle);
                            }
                            track-action(what, idx, arg) => {
                                root.track-action(TrackListId.artist-favorites, what, idx, arg);
                            }
                        }
                        if !root.artist-pure-credit && root.artist-credit-roles.length > 0: Rectangle {
                            height: 12px;
                        }
                        if !root.artist-pure-credit && root.artist-credit-roles.length > 0: ArtistTracksSection {
                            title: "幕后参与曲目";
                            artist-id: root.detail.id;
                            roles: root.artist-credit-roles;
                            active-role: root.artist-credit-role;
                            tracks: root.artist-credits;
                            playing-id: root.playing-id;
                            playlists: root.playlist-choices;
                            flex: artist-flick.flex;
                            role-selected(role) => {
                                root.artist-credit-role-changed(role);
                            }
                            play-all(shuffle) => {
                                root.play-list(TrackListId.artist-credits, shuffle);
                            }
                            track-action(what, idx, arg) => {
                                root.track-action(TrackListId.artist-credits, what, idx, arg);
                            }
                        }
                    }
                }

                // Track versions / recordings (same-title tracks across albums).
                if root.page == 10 && root.detail.kind == DetailKind.versions: versions-scroll := ScrollView {
                    content-y <=> root.content-scroll-y;
                    VerticalLayout {
                        alignment: start;
                        padding-bottom: 32px;
                        VerticalLayout {
                            padding-left: Shell.pad;
                            padding-right: Shell.pad;
                            padding-top: 56px;
                            padding-bottom: 24px;
                            spacing: 8px;
                            Text {
                                text: root.detail-loading && root.detail.title == "" ? "加载中…" : root.detail.title;
                                font-family: Fonts.display(self.text);
                                font-size: Shell.tier == 2 ? 44px : 34px;
                                font-weight: 600;
                                letter-spacing: Fonts.display(self.text) == "Source Serif 4" ? -0.7px : 0px;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                            if root.detail.subtitle != "": Text {
                                text: root.detail.subtitle;
                                font-family: Fonts.family(self.text);
                                font-size: 16px;
                                color: Theme.text-dim;
                            }
                            if root.detail.meta != "": Text {
                                text: root.detail.meta;
                                font-family: Fonts.family(self.text);
                                font-size: 13px;
                                color: Theme.text-faint;
                            }
                            Rectangle { height: 10px; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                play-split := Rectangle {
                                    property <length> main-w: v-play-row.preferred-width;
                                    width: self.main-w + 37px;
                                    height: 38px;
                                    border-radius: 19px;
                                    background: Theme.accent;
                                    HorizontalLayout {
                                        spacing: 0px;
                                        Rectangle {
                                            width: play-split.main-w;
                                            height: 38px;
                                            border-top-left-radius: 19px;
                                            border-bottom-left-radius: 19px;
                                            background: v-play-area.has-hover ? #ffffff22 : transparent;
                                            v-play-row := HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 12px;
                                                spacing: 8px;
                                                Icon {
                                                    kind: IconKind.play;
                                                    width: 13px;
                                                    height: 13px;
                                                    y: (parent.height - self.height) / 2;
                                                    color: #ffffff;
                                                }
                                                Text {
                                                    text: "现在播放";
                                                    font-family: Fonts.family(self.text);
                                                    color: #ffffff;
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            v-play-area := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.detail-action("play", 0); }
                                            }
                                        }
                                        Rectangle { width: 1px; height: 38px; background: #ffffff55; }
                                        Rectangle {
                                            width: 36px;
                                            height: 38px;
                                            border-top-right-radius: 19px;
                                            border-bottom-right-radius: 19px;
                                            background: v-shuf-area.has-hover ? #ffffff22 : transparent;
                                            Icon {
                                                x: 9px;
                                                y: (parent.height - self.height) / 2;
                                                kind: IconKind.shuffle;
                                                width: 15px;
                                                height: 15px;
                                                color: #ffffff;
                                            }
                                            v-shuf-area := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.detail-action("shuffle", 0); }
                                            }
                                        }
                                    }
                                }
                                GhostButton {
                                    text: "下一首播放";
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.detail-action("next", 0); }
                                }
                                GhostButton {
                                    text: "添加到末尾";
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.detail-action("last", 0); }
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: Shell.pad;
                            padding-right: Shell.pad;
                            height: 44px;
                            spacing: 10px;
                            Text {
                                text: "录音";
                                font-family: Fonts.family(self.text);
                                color: Theme.text;
                                font-size: 20px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.detail-tracks.length;
                                font-family: Fonts.family(self.text);
                                color: Theme.text-faint;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        Rectangle {
                            height: 1px;
                            Rectangle {
                                x: Shell.pad;
                                width: parent.width - 2 * Shell.pad;
                                background: Theme.border;
                            }
                        }

                        if root.detail-tracks.length == 0: Text {
                            height: 96px;
                            text: root.detail-loading ? "加载中…" : "没有找到同名录音";
                            font-family: Fonts.family(self.text);
                            color: Theme.text-faint;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        for track in root.detail-tracks: Rectangle {
                            property <bool> is-playing: track.id == root.playing-id;
                            height: 84px;
                            Rectangle {
                                x: Shell.pad - 12px;
                                width: parent.width - 2 * Shell.pad + 24px;
                                border-radius: 8px;
                                background: is-playing ? @linear-gradient(90deg, Theme.accent-dim 0%, Theme.accent-dim.with-alpha(0) 100%)
                                    : v-row-area.has-hover ? Theme.surface-hover : transparent;
                            }
                            if !is-playing: Rectangle {
                                x: Shell.pad;
                                y: parent.height - 1px;
                                width: parent.width - 2 * Shell.pad;
                                height: 1px;
                                background: Theme.border;
                            }
                            v-row-area := TouchArea {
                                double-clicked => { root.track-action(TrackListId.detail, "play", track.index, 0); }
                            }
                            HorizontalLayout {
                                padding-left: Shell.pad;
                                padding-right: Shell.pad;
                                spacing: 16px;
                                Rectangle {
                                    width: 54px;
                                    height: 54px;
                                    y: (parent.height - self.height) / 2;
                                    Rectangle {
                                        width: ArtFit.width(54px, 54px, track.cover);
                                        height: ArtFit.height(54px, 54px, track.cover);
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4px;
                                        background: track.cover.width == 0 ? Theme.raised : transparent;
                                        clip: true;
                                        if track.cover.width == 0: Icon {
                                            kind: IconKind.disc;
                                            width: 22px;
                                            height: 22px;
                                            color: Theme.text-faint;
                                        }
                                        if track.cover.width > 0: Image {
                                            source: track.cover;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: ImageFit.cover;
                                        }
                                        if is-playing || v-row-area.has-hover || v-cover-area.has-hover: Rectangle {
                                            background: #00000066;
                                            if is-playing: PlayingBars {
                                                width: 15px;
                                                height: 14px;
                                                bar-color: #ffffff;
                                            }
                                            if !is-playing: Icon {
                                                kind: IconKind.play;
                                                width: 16px;
                                                height: 16px;
                                                color: #ffffff;
                                            }
                                        }
                                        v-cover-area := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.track-action(TrackListId.detail, "play", track.index, 0); }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 3px;
                                    if track.year != "": Text {
                                        text: "版本 " + track.year;
                                        font-family: Fonts.family(self.text);
                                        color: Theme.text-faint;
                                        font-size: 11.5px;
                                    }
                                    Text {
                                        text: track.title;
                                        font-family: Fonts.family(self.text);
                                        color: is-playing ? Theme.accent-text : Theme.text;
                                        font-size: 15px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        min-width: 0px;
                                        spacing: 28px;
                                        alignment: start;
                                        if track.artist != "": HorizontalLayout {
                                            min-width: 0px;
                                            spacing: 6px;
                                            Text {
                                                text: "演出者";
                                                font-family: Fonts.family(self.text);
                                                color: Theme.text-faint;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 0;
                                            }
                                            ArtistLinks {
                                                fallback: track.artist;
                                                artists: track.artists;
                                                font-size: 12.5px;
                                                open(id) => { root.track-action(TrackListId.detail, "artist", track.index, id); }
                                            }
                                        }
                                        if track.album != "": HorizontalLayout {
                                            min-width: 0px;
                                            spacing: 6px;
                                            Text {
                                                text: "出演于";
                                                font-family: Fonts.family(self.text);
                                                color: Theme.text-faint;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                horizontal-stretch: 0;
                                            }
                                            Text {
                                                text: track.album;
                                                font-family: Fonts.family(self.text);
                                                color: track.album-id > 0 && v-alb-area.has-hover ? Theme.accent-text : Theme.text-dim;
                                                font-size: 12.5px;
                                                overflow: elide;
                                                min-width: ArtistLayout.cap-width(track.album, 12.5px, 100px);
                                                vertical-alignment: center;
                                                v-alb-area := TouchArea {
                                                    enabled: track.album-id > 0;
                                                    mouse-cursor: track.album-id > 0 ? pointer : default;
                                                    clicked => { root.track-action(TrackListId.detail, "album", track.index, track.album-id); }
                                                }
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: track.duration;
                                    color: Theme.text-dim;
                                    font-size: 13.5px;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 32px;
                                    Icon {
                                        visible: track.favorite || v-row-area.has-hover || v-heart-area.has-hover;
                                        kind: track.favorite ? IconKind.heart : IconKind.heart-outline;
                                        width: 17px;
                                        height: 17px;
                                        color: track.favorite ? Theme.accent-text : v-heart-area.has-hover ? Theme.text : Theme.text-faint;
                                    }
                                    v-heart-area := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.track-action(TrackListId.detail, "favorite", track.index, track.favorite ? 0 : 1); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.page == 20: HomePage {
                    scroll-y <=> root.content-scroll-y;
                    playlists: root.playlist-choices;
                    playing-id: root.playing-id;
                    playing-mix: root.playing-mix;
                    card-action(grid, what, id, arg) => {
                        root.card-action(grid, what, id, arg);
                    }
                    card-layout(grid, n, size) => {
                        root.card-layout-changed(grid, n, size);
                    }
                    card-limit(grid, n) => {
                        root.card-limit-changed(grid, n);
                    }
                    track-action(list, what, i, arg) => {
                        root.track-action(list, what, i, arg);
                    }
                    navigate(page, id) => {
                        root.navigate(page, id);
                    }
                    open-web(path) => {
                        Lib032.open-web(path);
                    }
                }

                if root.page == 21: WorksPage {
                    scroll-y <=> root.content-scroll-y;
                    playlists: root.playlist-choices;
                    card-action(what, id, arg) => {
                        root.card-action(GridId.works, what, id, arg);
                    }
                    card-layout(n, size) => {
                        root.card-layout-changed(GridId.works, n, size);
                    }
                }

                if root.page == 22: SeriesPage {
                    scroll-y <=> root.content-scroll-y;
                    card-action(what, id, arg) => {
                        root.card-action(GridId.series, what, id, arg);
                    }
                    card-layout(n, size) => {
                        root.card-layout-changed(GridId.series, n, size);
                    }
                }

                if root.page == 23: HistoryPage {
                    scroll-y <=> root.content-scroll-y;
                    playing-id: root.playing-id;
                    playlists: root.playlist-choices;
                    track-action(what, i, arg) => {
                        root.track-action(TrackListId.history, what, i, arg);
                    }
                    clear => {
                        root.content-scroll-y = 0px;
                        root.dialog-message = "这会永久清除全部播放次数和断点位置，不会删除歌曲或收藏。此操作不可撤销。";
                        root.dialog = DialogKind.clear-history;
                    }
                }

                if root.page == 10 && root.detail.kind == DetailKind.work: WorkPage {
                    scroll-y <=> root.content-scroll-y;
                    tracks: root.detail-tracks;
                    loading: root.detail-loading;
                    playing-id: root.playing-id;
                    playlists: root.playlist-choices;
                    card-action(what, id, arg) => {
                        root.card-action(GridId.work-albums, what, id, arg);
                    }
                    card-layout(n, size) => {
                        root.card-layout-changed(GridId.work-albums, n, size);
                    }
                    card-row-shown(row) => {
                        root.card-row-shown(GridId.work-albums, row);
                    }
                    track-action(what, i, arg) => {
                        root.track-action(TrackListId.detail, what, i, arg);
                    }
                    navigate(page, id) => {
                        root.navigate(page, id);
                    }
                }

                if root.page == 10 && root.detail.kind == DetailKind.series: SeriesDetailPage {
                    scroll-y <=> root.content-scroll-y;
                    loading: root.detail-loading;
                    playlists: root.playlist-choices;
                    card-action(grid, what, id, arg) => {
                        root.card-action(grid, what, id, arg);
                    }
                    card-layout(grid, n, size) => {
                        root.card-layout-changed(grid, n, size);
                    }
                    card-row-shown(grid, row) => {
                        root.card-row-shown(grid, row);
                    }
                }

                if root.page == 10 && root.detail.kind == DetailKind.daily-mix: MixPage {
                    scroll-y <=> root.content-scroll-y;
                    tracks: root.detail-tracks;
                    loading: root.detail-loading;
                    playing-id: root.playing-id;
                    playing-mix: root.playing-mix;
                    playlists: root.playlist-choices;
                    track-action(what, i, arg) => {
                        root.track-action(TrackListId.detail, what, i, arg);
                    }
                    open-mix(id) => {
                        root.navigate(15, id);
                    }
                    play-mix(id) => {
                        Home.action("mix-play", id);
                    }
                }

                if root.page == 2: SettingsView {
                    scroll-y <=> root.content-scroll-y;
                    shortcuts: root.shortcuts;
                    recording: root.recording-shortcut;
                    record-shortcut(i) => { root.recording-shortcut = i; }
                    clear-shortcut(i) => { root.clear-shortcut(i); }
                    reset-shortcuts => { root.reset-shortcuts(); }
                    server-label: root.server-label;
                    logout => {
                        root.logout();
                    }
                    app-version: root.app-version;
                    update-version: root.update-version;
                    open-update => {
                        root.open-update();
                    }
                    open-logs => {
                        root.open-logs();
                    }
                    devices: root.audio-devices;
                    device-index <=> root.audio-device-index;
                    exclusive <=> root.exclusive;
                    exclusive-mode <=> root.exclusive-mode;
                    asio-available: root.asio-available;
                    asio-configured: root.asio-configured;
                    asio-fallback: root.asio-fallback;
                    asio-drivers: root.asio-drivers;
                    asio-driver-index <=> root.asio-driver-index;
                    asio-status: root.asio-status;
                    asio-channel-pairs: root.asio-channel-pairs;
                    asio-channel-pair-index <=> root.asio-channel-pair-index;
                    output-busy: root.output-busy;
                    opened => {
                        root.settings-opened();
                    }
                    device-selected(i) => {
                        root.output-busy = true;
                        root.audio-device-selected(i);
                    }
                    exclusive-toggled(on) => {
                        root.output-busy = true;
                        root.exclusive-toggled(on);
                    }
                    exclusive-mode-selected(m) => {
                        root.output-busy = true;
                        root.exclusive-mode-selected(m);
                    }
                    asio-driver-selected(i) => {
                        root.asio-driver-selected(i);
                    }
                    asio-channel-pair-selected(i) => {
                        root.asio-channel-pair-selected(i);
                    }
                    refresh-asio-driver => {
                        root.refresh-asio-driver();
                    }
                    open-asio-control-panel => {
                        root.open-asio-control-panel();
                    }
                    tray-available: root.tray-available;
                    close-to-tray <=> root.close-to-tray;
                    close-to-tray-toggled(on) => {
                        root.close-to-tray-toggled(on);
                    }
                    theme-mode <=> root.theme-mode;
                    theme-selected(i) => {
                        root.theme-selected(i);
                    }
                    fade-on-pause <=> root.fade-on-pause;
                    fade-on-pause-toggled(on) => {
                        root.fade-on-pause-toggled(on);
                    }
                    loudness-supported: root.loudness-supported;
                    loudness-summary: root.loudness-summary;
                    loudness-enabled <=> root.loudness-enabled;
                    loudness-target <=> root.loudness-target;
                    loudness-mode <=> root.loudness-mode;
                    loudness-peak-mode <=> root.loudness-peak-mode;
                    loudness-changed => {
                        root.loudness-changed();
                    }
                    transcode-options: root.transcode-options;
                    transcode-index <=> root.transcode-index;
                    transcode-selected(i) => {
                        root.transcode-selected(i);
                    }
                    lyrics-translation: root.lyrics-translation-available;
                    lyrics-language <=> root.lyrics-language;
                    lyrics-mode <=> root.lyrics-mode;
                    lyrics-auto <=> root.lyrics-auto;
                    lyrics-changed => {
                        root.lyrics-settings-changed();
                    }
                }

            }

            // 8px chassis gap between main canvas and docked right panel; on
            // wide windows it doubles as the panel resize handle.
            if root.panel-docked: Rectangle {
                width: 8px;
                background: transparent;
                if root.wide: Rectangle {
                    width: 100%;
                    height: 100%;
                    property <length> press-x;
                    Rectangle {
                        x: 3px;
                        y: 12px;
                        width: 2px;
                        height: parent.height - 24px;
                        border-radius: 1px;
                        background: panel-edge.has-hover || panel-edge.pressed ? Theme.accent : transparent;
                    }
                    panel-edge := TouchArea {
                        mouse-cursor: col-resize;
                        pointer-event(e) => {
                            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                parent.press-x = self.mouse-x;
                            }
                            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                                root.panel-width = root.panel-w;
                                root.panel-changed();
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.panel-width = clamp(root.panel-w - (self.mouse-x - parent.press-x), 300px, root.panel-max);
                            }
                        }
                    }
                }
            }

            // Room for the docked right panel (drawn above, see `right`).
            if root.panel-docked: Rectangle {
                width: root.panel-w;
            }
        }

        PlayerBar {
            tier: root.tier;
            exclusive: root.exclusive;
            exclusive-mode: root.exclusive-mode;
            preferred-exclusive-mode: root.preferred-exclusive-mode;
            asio-configured: root.asio-configured;
            asio-fallback: root.asio-fallback;
            exclusive-busy: root.output-busy;
            wasapi-device-label: root.wasapi-device-label;
            asio-driver-label: root.asio-driver-label;
            asio-error: root.asio-error;
            interacted => {
                root.blur-search();
            }
            toggle-exclusive => {
                root.blur-search();
                root.output-busy = true;
                root.exclusive-quick-toggled();
            }
            select-exclusive-mode(m) => {
                root.blur-search();
                root.output-busy = true;
                root.exclusive-mode-selected(m);
            }
            open-audio-settings => {
                root.blur-search();
                root.navigate(2, 0);
            }
            has-track: root.has-track;
            show-cover: !root.panel-shown || root.full-open;
            full-open: root.full-open;
            toggle-full => {
                root.blur-search();
                if root.full-open {
                    root.close-full();
                } else {
                    root.open-full(0);
                }
            }
            title: root.np-title;
            artist: root.np-artist;
            album: root.np-album;
            quality: root.np-quality;
            cover: root.np-cover;
            artists: root.np-artists;
            favorite: root.np-favorite;
            position-ms: root.position-ms;
            duration-ms: root.duration-ms;
            position-text: root.position-text;
            duration-text: root.duration-text;
            paused: root.paused;
            buffering: root.buffering;
            volume: root.volume;
            lyrics-open: root.panel-shown && !root.panel-queue-tab;
            queue-open: root.panel-shown && root.panel-queue-tab;
            shuffle: root.shuffle;
            repeat: root.repeat;
            sleep-active: root.sleep-active;
            sleep-label: root.sleep-label;
            set-sleep(mode, minutes) => {
                root.blur-search();
                root.set-sleep(mode, minutes);
            }
            toggle-favorite => {
                root.blur-search();
                root.toggle-now-favorite();
            }
            open-album => {
                root.blur-search();
                root.open-now-album();
            }
            open-artist(id) => {
                root.blur-search();
                root.open-now-artist(id);
            }
            toggle-queue => {
                root.blur-search();
                root.toggle-panel(true);
            }
            toggle-shuffle => {
                root.blur-search();
                root.toggle-shuffle();
            }
            cycle-repeat => {
                root.blur-search();
                root.cycle-repeat();
            }
            toggle-pause => {
                root.blur-search();
                root.toggle-pause();
            }
            next => {
                root.blur-search();
                root.next();
            }
            previous => {
                root.blur-search();
                root.previous();
            }
            seek(ms) => {
                root.blur-search();
                root.seek(ms);
            }
            volume-changed(v) => {
                root.blur-search();
                root.volume = v;
                root.volume-changed(v);
            }
            toggle-lyrics => {
                root.blur-search();
                root.toggle-panel(false);
            }
        }
    }

    // Right "now playing" panel (D2): docked beside the pages inside the
    // chassis, or an overlay drawer on narrow windows.
    if root.logged-in && root.panel-shown: right := Rectangle {
        x: root.width - self.width - 8px;
        y: root.top-bar-h;
        width: root.panel-w;
        height: root.height - root.top-bar-h - root.bar-h;
        border-radius: 10px;
        drop-shadow-blur: root.small ? 32px : 0px;
        drop-shadow-offset-x: root.small ? -8px : 0px;
        drop-shadow-color: root.small ? (Theme.dark ? #0000008c : #11111329) : transparent;
        np := NowPlayingPanel {
            width: 100%;
            height: 100%;
            has-track: root.has-track;
            title: root.np-title;
            artist: root.np-artist;
            album: root.np-album;
            quality: root.np-quality;
            cover: root.np-cover-large;
            artists: root.np-artists;
            favorite: root.np-favorite;
            // Not while a Sonos room plays.
            exclusive: root.exclusive && CastState.output-id == "";
            exclusive-mode: root.exclusive-mode;
            asio-fallback: root.asio-fallback;
            bit-perfect: root.transcode-index == 0;
            art: root.np-art-side;
            tab: root.panel-queue-tab ? 1 : 0;
            queue-count: root.queue-total;
            lyrics-source: root.lyrics-source;
            floating: root.small;
            interacted => {
                root.blur-search();
            }
            tab-selected(i) => {
                root.blur-search();
                root.panel-queue-tab = i == 1;
                root.panel-changed();
            }
            toggle-favorite => {
                root.blur-search();
                root.toggle-now-favorite();
            }
            open-album => {
                root.blur-search();
                root.open-now-album();
            }
            open-artist(id) => {
                root.blur-search();
                root.open-now-artist(id);
            }
            open-full => {
                root.blur-search();
                root.open-full(0);
            }

            if !root.panel-queue-tab: LyricsPanel {
                x: 0;
                y: 0;
                width: np.pane-width;
                height: np.pane-height;
                fades: true;
                fade: Theme.panel;
                lines: root.lyrics;
                active: root.lyrics-active;
                synced: root.lyrics-synced;
                source: root.lyrics-source;
                has-track: root.has-track;
                lines-have-translation: root.lyrics-translated-lines;
                can-search: root.lyrics-can-search;
                can-translate: root.lyrics-can-translate;
                translation-shown: root.lyrics-translation-shown;
                translating: root.lyrics-translating;
                offset-ms: root.lyrics-offset;
                reset-seq: root.lyrics-reset-seq;
                seek-line(i) => {
                    root.lyrics-seek(i);
                }
                tool(what) => {
                    if what == "search" {
                        root.dialog = DialogKind.lyrics-search;
                    }
                    root.lyrics-tool(what);
                }
                offset(ms) => {
                    root.lyrics-offset-changed(ms);
                }
            }
            if root.panel-queue-tab: QueuePanel {
                x: 0;
                y: 0;
                width: np.pane-width;
                height: np.pane-height;
                background: transparent;
                show-title: false;
                side-padding: 24px;
                rows: root.queue;
                total: root.queue-total;
                current: root.queue-current;
                playlists: root.playlist-choices;
                search <=> root.queue-search;
                search-changed(text) => {
                    root.queue-search-changed(text);
                }
                save => {
                    root.save-queue();
                }
                play(uid) => {
                    root.play-queue-item(uid);
                }
                remove(uid) => {
                    root.remove-queue-item(uid);
                }
                move(uid, to) => {
                    root.move-queue-item(uid, to);
                }
                row-action(what, uid, arg) => {
                    root.queue-row-action(what, uid, arg);
                }
                clear => {
                    root.clear-queue();
                }
            }
        }
    }

    if root.logged-in && root.full-open: full := FullScreenPlayer {
        x: 8px;
        y: root.top-bar-h;
        width: root.width - 16px;
        // The top TitleBar and bottom player bar stay visible.
        height: root.height - root.top-bar-h - root.bar-h;
        cover: root.full-cover;
        has-track: root.has-track;
        title: root.np-title;
        artist: root.np-artist;
        artists: root.np-artists;
        album: root.np-album;
        year: root.np-year;
        quality: root.np-quality;
        exclusive: root.exclusive && CastState.output-id == "";
        exclusive-mode: root.exclusive-mode;
        asio-fallback: root.asio-fallback;
        bit-perfect: root.transcode-index == 0;
        lyrics-source: root.lyrics-source;
        tab: root.full-tab;
        tab-selected(i) => {
            root.full-tab = i;
            root.full-changed();
        }
        close => {
            root.close-full();
        }
        open-album => {
            root.open-now-album();
        }
        open-artist(id) => {
            root.open-now-artist(id);
        }
        show-info => {
            root.now-info();
        }
        cover-resized(side) => {
            root.full-cover-side = side;
            root.full-changed();
        }

        // Up next: dedicated right surface card (wide) or first tab (narrow).
        if full.wide || root.full-tab != 2: QueuePanel {
            x: full.wide ? full.side-x : full.pane-x;
            y: full.wide ? full.side-y : full.pane-y;
            width: full.wide ? full.side-w : full.pane-width;
            height: full.wide ? full.side-h : full.pane-height;
            stage: true;
            stage-head: full.wide;
            show-title: false;
            rows: root.queue;
            total: root.queue-total;
            current: root.queue-current;
            position: root.queue-position;
            playlists: root.playlist-choices;
            search <=> root.queue-search;
            search-changed(text) => {
                root.queue-search-changed(text);
            }
            save => {
                root.save-queue();
            }
            play(uid) => {
                root.play-queue-item(uid);
            }
            remove(uid) => {
                root.remove-queue-item(uid);
            }
            move(uid, to) => {
                root.move-queue-item(uid, to);
            }
            row-action(what, uid, arg) => {
                root.queue-row-action(what, uid, arg);
            }
            clear => {
                root.clear-queue();
            }
        }
        // Lyrics: the middle column (wide, tools in its header) or the
        // lyrics tab (centered, tools at the bottom).
        if full.wide || root.full-tab == 2: LyricsPanel {
            x: full.wide ? full.lyrics-x - 8px : full.pane-x;
            y: full.wide ? full.lyrics-y : full.pane-y;
            width: full.wide ? full.lyrics-w + 16px : full.pane-width;
            height: full.wide ? full.lyrics-h : full.pane-height;
            large: !full.wide;
            stage: full.wide;
            show-tools: !full.wide;
            side-padding: full.wide ? 8px : 24px;
            fades: true;
            fade: Theme.stage;
            lines: root.lyrics;
            active: root.lyrics-active;
            synced: root.lyrics-synced;
            source: root.lyrics-source;
            has-track: root.has-track;
            lines-have-translation: root.lyrics-translated-lines;
            can-search: root.lyrics-can-search;
            can-translate: root.lyrics-can-translate;
            translation-shown: root.lyrics-translation-shown;
            translating: root.lyrics-translating;
            offset-ms: root.lyrics-offset;
            reset-seq: root.lyrics-reset-seq;
            seek-line(i) => {
                root.lyrics-seek(i);
            }
            tool(what) => {
                if what == "search" {
                    root.dialog = DialogKind.lyrics-search;
                }
                root.lyrics-tool(what);
            }
            offset(ms) => {
                root.lyrics-offset-changed(ms);
            }
        }
        if full.wide && root.has-track && (root.lyrics-can-search || root.lyrics-synced || root.lyrics-can-translate): Rectangle {
            x: full.tools-x;
            y: full.tools-y;
            width: full-tools.preferred-width + 8px;
            height: 38px;
            border-radius: 12px;
            background: Theme.text.with-alpha(0.05);
            full-tools := LyricsTools {
                x: 4px;
                y: 4px;
                width: self.preferred-width;
                synced: root.lyrics-synced;
                has-lines: root.lyrics.length > 0;
                can-search: root.lyrics-can-search;
                can-translate: root.lyrics-can-translate;
                translation-shown: root.lyrics-translation-shown;
                translating: root.lyrics-translating;
                offset-ms: root.lyrics-offset;
                on-stage: true;
                tool(what) => {
                    if what == "search" {
                        root.dialog = DialogKind.lyrics-search;
                    }
                    root.lyrics-tool(what);
                }
                offset(ms) => {
                    root.lyrics-offset-changed(ms);
                }
            }
        }
    }

    // Modals sit below the custom TitleBar so window dragging and caption
    // buttons stay responsive while a dialog is open.
    if root.dialog != DialogKind.none: Rectangle {
        x: 0px;
        y: root.top-bar-h;
        width: root.width;
        height: root.height - root.top-bar-h;

        if root.dialog == DialogKind.new-playlist || root.dialog == DialogKind.edit-playlist: PromptDialog {
            title: root.dialog == DialogKind.new-playlist ? "新建歌单" : "编辑歌单";
            confirm-text: root.dialog == DialogKind.new-playlist ? "创建" : "保存";
            name <=> root.dialog-name;
            description <=> root.dialog-description;
            confirm(name, description) => {
                root.dialog-confirm(name, description);
                root.dialog = DialogKind.none;
            }
            cancel => {
                root.dialog = DialogKind.none;
            }
        }

        if root.dialog == DialogKind.clear-history: ConfirmDialog {
            title: "确定清空全部播放记录吗？";
            message: root.dialog-message;
            confirm-text: "永久清空";
            confirm => {
                root.dialog = DialogKind.none;
                Lib032.detail-action("clear-history", 0);
            }
            cancel => {
                root.dialog = DialogKind.none;
            }
        }

        if root.dialog == DialogKind.pick-artist: Rectangle {
            background: #00000099;
            TouchArea { clicked => { root.dialog = DialogKind.none; } }
            Rectangle {
                width: min(440px, parent.width - 64px);
                height: min(artist-menu.preferred-height, parent.height - 64px);
                border-radius: 12px;
                background: Theme.surface;
                TouchArea { }
                artist-menu := VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: "选择艺术家"; color: Theme.text; font-size: 18px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                        IconButton { kind: IconKind.close; size: 30px; clicked => { root.dialog = DialogKind.none; } }
                    }
                    ScrollView {
                        height: min(root.artist-choices.length * 44px, 360px);
                        VerticalLayout {
                            for artist in root.artist-choices: Rectangle {
                                height: 44px;
                                border-radius: 6px;
                                background: artist-choice.has-hover ? Theme.surface-hover : transparent;
                                Text { x: 12px; width: parent.width - 24px; text: artist.text; font-family: Fonts.family(self.text); color: Theme.text; overflow: elide; vertical-alignment: center; }
                                artist-choice := TouchArea { mouse-cursor: pointer; clicked => { root.artist-chosen(artist.id); } }
                            }
                        }
                    }
                }
            }
        }

        if root.dialog == DialogKind.track-info: InfoDialog {
            rows: root.info-rows;
            close => {
                root.dialog = DialogKind.none;
            }
        }

        if root.dialog == DialogKind.lyrics-search: LyricsSearchDialog {
            close => {
                root.dialog = DialogKind.none;
            }
        }

        if root.dialog == DialogKind.delete-playlist: ConfirmDialog {
            title: "删除歌单";
            message: root.dialog-message;
            confirm-text: "删除";
            confirm => {
                root.dialog-confirm("", "");
                root.dialog = DialogKind.none;
            }
            cancel => {
                root.dialog = DialogKind.none;
            }
        }
    }

    // Context menu sits below TitleBar in z-order so caption buttons and
    // dragging remain responsive even while a menu is open.
    if ContextMenuState.open: ContextMenuOverlay {
        top-inset: root.top-bar-h;
    }

    // Integrated 38px chrome TitleBar (Option D chassis).
    title-bar := TitleBar {
        x: 0px;
        y: 0px;
        width: root.width;
        app-icon: root.icon;
        logged-in: root.logged-in;
        full-open: root.full-open;
        modal-open: root.dialog != DialogKind.none;
        small: root.small;
        can-go-back: root.can-go-back;
        crumb: root.top-crumb;
        search-shortcut: root.search-shortcut;
        search-text <=> SearchState.query-input;
        panel-open: root.panel-shown;
        window-active: root.window-active;
        window-maximized: root.window-maximized;
        resize-inset: root.resize-inset;
        chrome-pressed => {
            ContextMenuState.close();
        }
        go-back => {
            ContextMenuState.close();
            root.blur-search();
            root.go-back();
        }
        close-full => {
            ContextMenuState.close();
            root.close-full();
        }
        search-edited => {
            if !root.logged-in || root.full-open || root.dialog != DialogKind.none {
                return;
            }
            top-search-debounce.restart();
        }
        search-accepted => {
            top-search-debounce.running = false;
            if !root.logged-in || root.full-open || root.dialog != DialogKind.none {
                return;
            }
            if root.page != 6 {
                root.navigate(6, 0);
            }
            root.content-scroll-y = 0px;
            SearchState.search(SearchState.query-input);
        }
        search-cleared => {
            top-search-debounce.running = false;
            if !root.logged-in || root.full-open || root.dialog != DialogKind.none {
                return;
            }
            if root.page == 6 {
                root.content-scroll-y = 0px;
            }
            SearchState.search("");
        }
        search-escaped => {
            top-search-debounce.running = false;
            shortcut-scope.focus();
            if root.page == 6 && SearchState.query-input == "" && root.can-go-back {
                root.go-back();
            }
        }
        unfocus-search => {
            shortcut-scope.focus();
        }
        toggle-panel => {
            ContextMenuState.close();
            root.blur-search();
            root.toggle-right-panel();
        }
        window-drag => {
            ContextMenuState.close();
            root.window-drag();
        }
        window-minimize => {
            ContextMenuState.close();
            root.window-minimize();
        }
        window-toggle-maximize => {
            ContextMenuState.close();
            root.window-toggle-maximize();
        }
        window-close => {
            ContextMenuState.close();
            root.window-close();
        }
    }

    } // shortcut-scope

    // Toast.
    if root.notice != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - root.bar-h - self.height - 16px;
        width: min(560px, toast.preferred-width + 32px);
        height: toast.preferred-height + 20px;
        border-radius: Theme.radius;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.border;
        toast := Text {
            text: root.notice;
            font-family: Fonts.family(self.text);
            color: Theme.text;
            wrap: word-wrap;
            width: min(528px, self.preferred-width);
        }
    }

    // Crisp 1px outer perimeter border when not maximized (complements
    // Windows 11 DWM border color and frames the window on Win10 / Linux).
    if !root.window-maximized: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        border-width: 1px;
        border-color: root.window-active ? Theme.win-border : Theme.win-border-inactive;
    }
}
