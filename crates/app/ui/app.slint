import { TitleBar } from "title_bar.slint";
import {
    ListQuery, DetailInfo, ListToolbar, PageHeader, CardRows, DetailHeader, ArtistHeader, PromptDialog,
    ConfirmDialog, ReleaseGroupRow, CreditRoleTab, AlbumWorkRow, WorkUseRow, PersonRow, FactRow,
    AlbumInspector, InfoDialog,
} from "library.slint";
