import { Fonts, Theme } from "theme.slint";

// Horizontal bar with drag-to-set. `value` is 0..1; while dragging the bar
// follows the pointer and `committed` fires on release (`live` fires on move).
export component ValueBar inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    // Filled part; `knob`: the handle shows without hovering.
    in property <color> fill: Theme.text-dim;
    in property <bool> knob;
    callback committed(float);
    callback live(float);
    out property <bool> dragging: false;
    property <float> drag-value;
    property <float> shown: root.dragging ? root.drag-value : max(0, min(1, root.value));
    height: 16px;

    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.raised;
        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: 100%;
            border-radius: 2px;
            background: area.has-hover || root.dragging ? Theme.accent : root.fill;
        }
    }

    Rectangle {
        visible: root.enabled && (root.knob || area.has-hover || root.dragging);
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000080;
        x: parent.width * root.shown - 6px;
        y: (parent.height - 12px) / 2;
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.dragging = true;
                root.drag-value = max(0, min(1, self.mouse-x / self.width));
                root.live(root.drag-value);
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.committed(root.drag-value);
            }
            if e.kind == PointerEventKind.cancel && root.dragging {
                root.dragging = false;
            }
        }
        moved => {
            if root.dragging {
                root.drag-value = max(0, min(1, self.mouse-x / self.width));
                root.live(root.drag-value);
            }
        }
    }
}

// Playback state for indicators anywhere in the UI.
export global Playback {
    in property <bool> paused: true;
}

// "Now playing" equalizer bars (Electron playing indicator): three bars
// bouncing while playing, still while paused. Redraws continuously only
// while shown and playing (`animation-tick`).
export component PlayingBars inherits Rectangle {
    in property <color> bar-color: Theme.accent;
    property <bool> moving: !Playback.paused;
    property <float> t: self.moving ? animation-tick() / 1ms : 0;
    property <length> bar: max(2px, floor(root.width / 4 / 1px) * 1px);
    property <length> gap: (root.width - 3 * root.bar) / 2;
    for n[i] in 3: Rectangle {
        x: i * (root.bar + root.gap);
        width: root.bar;
        // Electron keyframes: 4px -> 12px -> 4px over 0.9s, bars 0.25s
        // apart; paused: all low.
        height: root.height * (root.moving ? 1 / 3 + 2 / 3 * (0.5 - 0.5 * cos((root.t / 900) * 360deg - i * 100deg)) : 1 / 3);
        y: root.height - self.height;
        border-radius: 1px;
        background: root.bar-color;
    }
}

export enum IconKind { play, pause, next, previous, lyrics, shuffle, repeat, repeat-one, queue, close, sleep, heart, heart-outline, back, search, plus, arrow-up, arrow-down, more, locate, trash, playlist-add, home, disc, note, person, people, work, layers, history, gear, list, logout, chevron-up, chevron-down, chevron-right, minus, volume, info, speaker, lang, expand, sliders, list-plus, sort-desc, check, cast, versions, radio, infinity, refresh, win-min, win-max, win-restore, panel-right }

export struct CastRoomRow {
    id: string,
    name: string,
    // "Sonos One", "Sonos · 2 个房间".
    detail: string,
}

// Sonos output (MusicBridge): the player bar's 投放 menu and its settings.
export global CastState {
    // The room playback goes to; empty: this computer.
    in property <string> output-id;
    // Shortened name for the player bar chip.
    in property <string> output-label;
    in property <[CastRoomRow]> rooms;
    in property <bool> searching;
    // Under the list: searching, nothing found, errors.
    in property <string> hint;
    // Hi-res lossless (0 MP3 320k, 1 FLAC 48 kHz, 2 original), Opus
    // (0 MP3 320k, 1 FLAC), speaker addresses to probe.
    in-out property <int> hires;
    in-out property <int> opus;
    in-out property <string> hosts;
    callback refresh();
    // A room id; empty: this computer.
    callback select(string);
    callback options-changed();
}

// 032 Similar Track Radio and Queue Auto-Continue state shared across
// NowPlayingPanel, FullScreenPlayer, QueuePanel, SettingsView and track menus.
export global RadioState {
    in property <bool> supported: false;
    in-out property <bool> auto-play: true;
    in property <bool> active-radio: false;
    in property <string> seed-title;
    // "基于《xxx》 · 声学 + 元数据混合"
    in property <string> section-subtitle;
    in property <bool> loading: false;
    // True while auto-play is enabled but paused by repeat or sleep timer.
    in property <bool> paused-by-mode: false;
    // Tail status card copy and CTA ("enable" / "sequential" / "load-more" / "").
    in property <string> tail-title;
    in property <string> tail-subtitle;
    in property <string> tail-action-label;
    in property <string> tail-action-kind;
    in property <bool> tail-primary;
    in property <bool> tail-error;

    callback toggle-auto-play(bool);
    callback start-from-current();
    callback refresh-batch();
    callback load-more();
    callback switch-sequential();
}

// Vector icons (Lucide style, 24 grid; `tools/icons/svg2slint.py` converts
// the redesign set). Transport icons and the full heart are filled, the
// others are stroked (1.7 at 24, round caps and joins).
export component Icon inherits Path {
    in property <IconKind> kind;
    in property <color> color: Theme.text;
    property <bool> filled: root.kind == IconKind.heart || root.kind == IconKind.next || root.kind == IconKind.pause || root.kind == IconKind.play || root.kind == IconKind.previous;
    // Stroked icons use the 1..23 box (the path fit leaves room for the
    // stroke), so they come out at the CSS size of the mockups.
    viewbox-x: root.filled ? 0 : 1;
    viewbox-y: root.filled ? 0 : 1;
    viewbox-width: root.filled ? 24 : 22;
    viewbox-height: root.filled ? 24 : 22;
    fill: root.filled ? root.color : transparent;
    stroke: root.filled ? transparent : root.color;
    stroke-width: root.filled ? 0 : max(1px, self.width * 1.7 / 24);
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: root.kind == IconKind.versions ? "M 3.2 4.2 L 6.2 4.2 L 6.2 19.8 L 3.2 19.8 Z M 8.8 4.2 L 11.8 4.2 L 11.8 19.8 L 8.8 19.8 Z M 14.2 4.6 L 17.1 3.8 L 20.8 19.4 L 17.9 20.2 Z"
        : root.kind == IconKind.play ? "M 7 4.6 L 7 19.4 A 1.1 1.1 0 0 0 8.66 20.34 L 20.76 12.94 A 1.1 1.1 0 0 0 20.76 11.06 L 8.66 3.66 A 1.1 1.1 0 0 0 7 4.6 Z"
        : root.kind == IconKind.pause ? "M 7.3 4 L 8.7 4 A 1.3 1.3 0 0 1 10 5.3 L 10 18.7 A 1.3 1.3 0 0 1 8.7 20 L 7.3 20 A 1.3 1.3 0 0 1 6 18.7 L 6 5.3 A 1.3 1.3 0 0 1 7.3 4 Z M 15.3 4 L 16.7 4 A 1.3 1.3 0 0 1 18 5.3 L 18 18.7 A 1.3 1.3 0 0 1 16.7 20 L 15.3 20 A 1.3 1.3 0 0 1 14 18.7 L 14 5.3 A 1.3 1.3 0 0 1 15.3 4 Z"
        : root.kind == IconKind.next ? "M 5.5 5.3 L 5.5 18.7 A 1 1 0 0 0 7.05 19.53 L 16.7 13.1 A 1.3 1.3 0 0 0 16.7 10.9 L 7.05 4.47 A 1 1 0 0 0 5.5 5.3 Z M 18.2 4.5 L 18.2 4.5 A 1.3 1.3 0 0 1 19.5 5.8 L 19.5 18.2 A 1.3 1.3 0 0 1 18.2 19.5 L 18.2 19.5 A 1.3 1.3 0 0 1 16.9 18.2 L 16.9 5.8 A 1.3 1.3 0 0 1 18.2 4.5 Z"
        : root.kind == IconKind.previous ? "M 18.5 5.3 L 18.5 18.7 A 1 1 0 0 1 16.95 19.53 L 7.3 13.1 A 1.3 1.3 0 0 1 7.3 10.9 L 16.95 4.47 A 1 1 0 0 1 18.5 5.3 Z M 5.8 4.5 L 5.8 4.5 A 1.3 1.3 0 0 1 7.1 5.8 L 7.1 18.2 A 1.3 1.3 0 0 1 5.8 19.5 L 5.8 19.5 A 1.3 1.3 0 0 1 4.5 18.2 L 4.5 5.8 A 1.3 1.3 0 0 1 5.8 4.5 Z"
        : root.kind == IconKind.lyrics ? "M 14 4 L 4 4 M 20 10 L 4 10 M 14 16 L 4 16 M 20 15 L 20 20 M 17.5 20 L 20 20"
        : root.kind == IconKind.shuffle ? "M 18 14 L 22 18 L 18 22 M 18 2 L 22 6 L 18 10 M 2 18 L 3.97 18 A 4 4 0 0 0 7.27 16.3 L 12.72 7.7 A 4 4 0 0 1 16.02 6 L 22 6 M 2 6 L 3.97 6 A 4 4 0 0 1 7.57 8.2 M 22 18 L 15.96 18 A 4 4 0 0 1 12.66 16.2 L 12.3 15.75"
        : root.kind == IconKind.repeat ? "M 17 2 L 21 6 L 17 10 M 3 11 L 3 10 A 4 4 0 0 1 7 6 L 21 6 M 7 22 L 3 18 L 7 14 M 21 13 L 21 14 A 4 4 0 0 1 17 18 L 3 18"
        : root.kind == IconKind.repeat-one ? "M 17 2 L 21 6 L 17 10 M 3 11 L 3 10 A 4 4 0 0 1 7 6 L 21 6 M 7 22 L 3 18 L 7 14 M 21 13 L 21 14 A 4 4 0 0 1 17 18 L 3 18 M 11 10 L 12 10 L 12 14"
        : root.kind == IconKind.queue ? "M 21 15 L 21 6 M 16 15.5 A 2.5 2.5 0 1 0 21 15.5 A 2.5 2.5 0 1 0 16 15.5 Z M 12 12 L 3 12 M 16 6 L 3 6 M 12 18 L 3 18"
        : root.kind == IconKind.close ? "M 18 6 L 6 18 M 6 6 L 18 18"
        : root.kind == IconKind.sleep ? "M 12 3 A 6 6 0 0 0 21 12 A 9 9 0 1 1 12 3 Z"
        : root.kind == IconKind.heart ? "M 19 14 C 20.49 12.54 22 10.79 22 8.5 A 5.5 5.5 0 0 0 16.5 3 C 14.74 3 13.5 3.5 12 5 C 10.5 3.5 9.26 3 7.5 3 A 5.5 5.5 0 0 0 2 8.5 C 2 10.8 3.5 12.55 5 14 L 12 21 Z"
        : root.kind == IconKind.heart-outline ? "M 19 14 C 20.49 12.54 22 10.79 22 8.5 A 5.5 5.5 0 0 0 16.5 3 C 14.74 3 13.5 3.5 12 5 C 10.5 3.5 9.26 3 7.5 3 A 5.5 5.5 0 0 0 2 8.5 C 2 10.8 3.5 12.55 5 14 L 12 21 Z"
