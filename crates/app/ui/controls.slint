}

export component IconButton inherits Rectangle {
    in property <IconKind> kind;
    in property <length> size: 36px;
    in property <length> icon-size: 18px;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> filled: false;
    // Small text at the top right (repeat-one "1").
    in property <string> badge;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.filled ? (area.pressed ? Theme.accent.darker(20%) : Theme.accent)
        : area.has-hover ? Theme.surface-hover : transparent;
    opacity: root.enabled ? 1 : 0.4;

    Icon {
        kind: root.kind;
        width: root.icon-size;
        height: root.icon-size;
        color: root.filled ? #ffffff : root.active ? Theme.accent-text : Theme.text;
    }

    if root.badge != "": Text {
        x: parent.width / 2 + root.icon-size / 2 - 4px;
        y: parent.height / 2 - root.icon-size / 2 - 4px;
        text: root.badge;
        font-family: Fonts.family(self.text);
        font-size: 10px;
        font-weight: 700;
        color: root.active ? Theme.accent : Theme.text;
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Rounded text input with label (std LineEdit has no dark 032 look).
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password: false;
    in-out property <string> text;
    callback accepted();
    callback edited();
    spacing: 6px;

    Text {
        text: root.label;
        font-family: Fonts.family(self.text);
        color: Theme.text-dim;
        font-size: 13px;
    }

    Rectangle {
        height: 38px;
        border-radius: Theme.radius;
        background: Theme.bg;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        editor-scope := FocusScope {
            width: parent.width;
            height: parent.height;
            key-pressed(e) => { return e.text == Key.Tab ? reject : accept; }
        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: 100%;
            vertical-alignment: center;
            text <=> root.text;
            color: Theme.text;
            selection-background-color: Theme.accent-dim;
            input-type: root.password ? InputType.password : InputType.text;
            single-line: true;
            accepted => {
                root.accepted();
            }
            edited => {
                root.edited();
            }
        }

        }
        Text {
            x: 12px;
            visible: root.text == "" && !input.has-focus;
            text: root.placeholder;
            font-family: Fonts.family(self.text);
            color: Theme.text-faint;
            vertical-alignment: center;
            height: 100%;
        }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> has-icon: false;
    in property <IconKind> icon: IconKind.play;
    callback clicked();
    height: 40px;
    preferred-width: primary-row.preferred-width + 8px;
    border-radius: self.height / 2;
    background: !root.enabled ? Theme.raised : area.pressed ? Theme.accent.darker(20%) : area.has-hover ? Theme.accent.brighter(10%) : Theme.accent;

    primary-row := HorizontalLayout {
        padding-left: root.has-icon ? 15px : 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;
        if root.has-icon: Icon {
            kind: root.icon;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            color: #ffffff;
        }
        Text {
            text: root.text;
            font-family: Fonts.family(self.text);
            color: root.enabled ? #ffffff : Theme.text-faint;
            font-size: 14.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Search box with icon, placeholder and clear button.
export component SearchField inherits Rectangle {
    in property <string> placeholder: "搜索";
    in-out property <string> text;
    // Fires on every edit (callers debounce) and on Enter.
    callback edited();
    callback accepted();
    forward-focus: input;
    height: 32px;
    border-radius: min(10px, self.height / 2);
    background: Theme.raised;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : transparent;

    Icon {
        x: 12px;
        kind: IconKind.search;
        width: 17px;
        height: 17px;
        color: Theme.text-faint;
    }

    editor-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(e) => { return e.text == Key.Tab ? reject : accept; }
    input := TextInput {
        x: 38px;
        width: parent.width - 38px - 28px;
        height: 100%;
        vertical-alignment: center;
        text <=> root.text;
        color: Theme.text;
        selection-background-color: Theme.accent-dim;
        single-line: true;
        edited => {
            root.edited();
        }
        accepted => {
            root.accepted();
        }
    }

    }
    Text {
        x: 38px;
        visible: root.text == "";
        text: root.placeholder;
        font-family: Fonts.family(self.text);
        color: Theme.text-faint;
        vertical-alignment: center;
        height: 100%;
    }

    if root.text != "": Rectangle {
        x: parent.width - 26px;
        width: 20px;
        height: 20px;
        Icon {
            kind: IconKind.close;
            width: 12px;
            height: 12px;
            color: clear-area.has-hover ? Theme.text : Theme.text-faint;
        }
        clear-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.text = "";
                root.edited();
                root.accepted();
            }
        }
    }
}

// Bordered text button, optionally with an icon.
export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <IconKind> icon: IconKind.plus;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked();
    height: 32px;
    min-width: label.preferred-width + (root.has-icon ? 52px : 32px);
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: root.active ? Theme.accent-dim : area.has-hover ? Theme.bar : Theme.raised;
    opacity: root.enabled ? 1 : 0.4;

    HorizontalLayout {
        padding-left: root.has-icon ? 14px : 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        if root.has-icon: Icon {
            kind: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            color: root.active ? Theme.accent-text : Theme.text;
        }
        label := Text {
            text: root.text;
            font-family: Fonts.family(self.text);
            color: root.active ? Theme.accent-text : Theme.text;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Small text input for numbers (year range).
export component SmallInput inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback edited();
    width: 64px;
    height: 32px;
    border-radius: min(10px, self.height / 2);
    background: Theme.raised;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : transparent;
    editor-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(e) => { return e.text == Key.Tab ? reject : accept; }
    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: 100%;
        vertical-alignment: center;
        text <=> root.text;
        color: Theme.text;
        single-line: true;
        input-type: InputType.number;
        edited => {
            root.edited();
        }
    }
    }
    Text {
        x: 8px;
        visible: root.text == "" && !input.has-focus;
        text: root.placeholder;
        font-family: Fonts.family(self.text);
        color: Theme.text-faint;
        vertical-alignment: center;
        height: 100%;
    }
}

// Removable filter label ("艺人：X ×").
export component Chip inherits Rectangle {
    in property <string> text;
    callback removed();
    height: 34px;
    width: chip-label.preferred-width + 46px;
    border-radius: self.height / 2;
    background: Theme.accent-dim;
    chip-label := Text {
        x: 14px;
        text: root.text;
        font-family: Fonts.family(self.text);
        color: Theme.accent-text;
        font-size: 13.5px;
        font-weight: 600;
        vertical-alignment: center;
        height: 100%;
    }
    Rectangle {
        x: parent.width - 28px;
        width: 18px;
        height: 18px;
        Icon {
            kind: IconKind.close;
            width: 15px;
            height: 15px;
            color: chip-area.has-hover ? Theme.text : Theme.accent-text;
        }
        chip-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.removed();
            }
        }
    }
}

// Tab strip entry (pill, like the right panel tabs).
export component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    width: tab-label.preferred-width + 28px;
    border-radius: 9px;
    background: root.selected ? Theme.raised : tab-area.has-hover ? Theme.surface-hover : transparent;
    tab-label := Text {
        text: root.text;
        font-family: Fonts.family(self.text);
        color: root.selected ? Theme.text : tab-area.has-hover ? Theme.text : Theme.text-dim;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
    }
    tab-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Detail and spotlight title: at most two lines, then elided. Relative
// size steps always stay below the requested maximum, even on narrow
// windows. Fill the width; the height follows the text.
export component BigTitle inherits Rectangle {
    in property <string> text;
    in property <length> max-size: 64px;
    in property <int> weight: 600;
    // Natural spacing keeps CJK titles open and readable.
    in property <float> tracking: 0;
    in property <color> text-color: Theme.text;
    property <string> family: Fonts.family(root.text);
    property <length> s1: min(root.max-size, max(32px, round(root.max-size * 0.85 / 1px) * 1px));
    property <length> s2: min(root.s1, max(32px, round(root.max-size * 0.7 / 1px) * 1px));
    property <length> s3: min(root.s2, max(32px, round(root.max-size * 0.6 / 1px) * 1px));
    out property <length> size: wrap0.preferred-height <= line0.preferred-height * 2.5 ? root.max-size
        : wrap1.preferred-height <= line1.preferred-height * 2.5 ? root.s1
        : wrap2.preferred-height <= line2.preferred-height * 2.5 ? root.s2 : root.s3;
    property <length> line-h: root.size == root.max-size ? line0.preferred-height : root.size == root.s1 ? line1.preferred-height
        : root.size == root.s2 ? line2.preferred-height : line3.preferred-height;
    property <length> wrap-h: root.size == root.max-size ? wrap0.preferred-height : root.size == root.s1 ? wrap1.preferred-height
        : root.size == root.s2 ? wrap2.preferred-height : wrap3.preferred-height;
    // Never widen the layout it sits in.
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    // The font's line box has leading above the caps and room for
    // descenders; the title box trims about a fifth of the size so the
    // lines sit tight like the mockup's `line-height: .9` (no clipping).
    property <length> natural-h: min(root.wrap-h, root.line-h * 2);
    height: root.natural-h - root.size * 0.22;

    wrap0 := Text { visible: false; width: root.width; text: root.text; font-family: root.family; font-size: root.max-size; font-weight: root.weight; letter-spacing: root.max-size * root.tracking; wrap: word-wrap; }
    line0 := Text { visible: false; text: root.text; font-family: root.family; font-size: root.max-size; font-weight: root.weight; }
    wrap1 := Text { visible: false; width: root.width; text: root.text; font-family: root.family; font-size: root.s1; font-weight: root.weight; letter-spacing: root.s1 * root.tracking; wrap: word-wrap; }
    line1 := Text { visible: false; text: root.text; font-family: root.family; font-size: root.s1; font-weight: root.weight; }
    wrap2 := Text { visible: false; width: root.width; text: root.text; font-family: root.family; font-size: root.s2; font-weight: root.weight; letter-spacing: root.s2 * root.tracking; wrap: word-wrap; }
    line2 := Text { visible: false; text: root.text; font-family: root.family; font-size: root.s2; font-weight: root.weight; }
    wrap3 := Text { visible: false; width: root.width; text: root.text; font-family: root.family; font-size: root.s3; font-weight: root.weight; letter-spacing: root.s3 * root.tracking; wrap: word-wrap; }
    line3 := Text { visible: false; text: root.text; font-family: root.family; font-size: root.s3; font-weight: root.weight; }
    shown := Text {
        x: 0;
        y: round(-root.size * 0.1 / 1phx) * 1phx;
        width: root.width;
        height: root.natural-h;
        text: root.text;
        font-family: root.family;
        font-size: root.size;
        font-weight: root.weight;
        letter-spacing: root.size * root.tracking;
        color: root.text-color;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
    }
}

// "查看全部 ›": a dim link with a chevron.
export component MoreLink inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    width: more-row.preferred-width;
    height: 24px;
    more-row := HorizontalLayout {
        spacing: 2px;
        Text {
            text: root.text;
            font-family: Fonts.family(self.text);
            color: more-area.has-hover && root.enabled ? Theme.text : Theme.text-dim;
            font-size: 13.5px;
            vertical-alignment: center;
        }
        Icon {
            kind: IconKind.chevron-right;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            color: more-area.has-hover && root.enabled ? Theme.text : Theme.text-dim;
        }
    }
    more-area := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

// Round 40px icon button on a light fill (spotlight / album heart, more).
export component RoundIconButton inherits Rectangle {
    in property <IconKind> kind;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <length> size: 40px;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: round-area.has-hover ? Theme.bar : Theme.raised;
    opacity: root.enabled ? 1 : 0.4;
    Icon {
        kind: root.kind;
        width: 17px;
        height: 17px;
        color: root.active ? Theme.accent-text : round-area.has-hover ? Theme.text : Theme.text-dim;
    }
    round-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Circular artist avatar with a neutral slate gradient and filled bust
// silhouette when no portrait is loaded (and clean backing for transparent
// PNG/WebP artwork).
export component ArtistAvatar inherits Rectangle {
    in property <image> source;
    in property <length> size: 64px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.source.width > 0 ? Theme.avatar-bg-bottom : transparent;
    clip: true;

    // Draw the gradient disc as a Path so it stays strictly circular on both
    // GPU (FemtoVG) and software renderers (the software renderer does not
    // round-clip Rectangle linear gradients).
    if root.source.width == 0: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: @linear-gradient(155deg, Theme.avatar-bg-top 0%, Theme.avatar-bg-bottom 100%);
        stroke: transparent;
        commands: "M 0.5 50 A 49.5 49.5 0 1 0 99.5 50 A 49.5 49.5 0 1 0 0.5 50 Z";
    }

    if root.source.width == 0: Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: @linear-gradient(180deg, Theme.avatar-fg-top 0%, Theme.avatar-fg-bottom 100%);
        stroke: transparent;
        // Head circle + smooth shoulders bounded along the r=49.5 circle arc so
        // the silhouette stays cleanly circular in both GPU and software renderers.
        commands: "M 33.5 37.5 A 16.5 16.5 0 1 0 66.5 37.5 A 16.5 16.5 0 1 0 33.5 37.5 Z M 15 85 C 20 69 33 61.5 50 61.5 C 67 61.5 80 69 85 85 A 49.5 49.5 0 0 1 15 85 Z";
    }

    if root.source.width > 0: Image {
        source: root.source;
        width: 100%;
        height: 100%;
        image-fit: ImageFit.cover;
    }

    @children

    // Subtle 1px inner ring separates the circular avatar from the page surface.
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.size / 2;
        border-width: 1px;
        border-color: root.source.width > 0 ? Theme.avatar-photo-ring : Theme.avatar-ring;
        background: transparent;
    }
}
