import { Fonts, Theme } from "theme.slint";
import { Icon, IconKind } from "controls.slint";

component TitleNavButton inherits Rectangle {
    in property <IconKind> kind;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> dimmed: false;
    in property <length> btn-width: 32px;
    in property <length> btn-height: 32px;
    in property <length> icon-size: 17px;
    callback clicked();
    width: root.btn-width;
    height: root.btn-height;
    border-radius: 8px;
    background: !root.enabled ? transparent
        : root.active ? Theme.accent-dim
        : area.pressed ? Theme.win-btn-active
        : area.has-hover ? Theme.win-btn-hover
        : transparent;
    opacity: !root.enabled ? 0.28 : (root.dimmed && !area.has-hover) ? 0.55 : 1.0;

    Icon {
        kind: root.kind;
        width: root.icon-size;
        height: root.icon-size;
        color: root.active ? Theme.accent-text : area.has-hover ? Theme.text : Theme.text-dim;
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

component WinCaptionButton inherits Rectangle {
    in property <IconKind> kind;
    in property <bool> is-close: false;
    in property <bool> dimmed: false;
    in property <bool> rounded: false;
    in property <bool> wide: false;
    callback clicked();
    width: root.wide ? 56px : 48px;
    height: 100%;
    border-radius: root.rounded ? 6px : 0px;
    background: area.pressed
        ? (root.is-close ? Theme.win-close-hover.darker(15%) : Theme.win-btn-active)
        : area.has-hover
            ? (root.is-close ? Theme.win-close-hover : Theme.win-btn-hover)
            : transparent;

    Icon {
        kind: root.kind;
        width: root.wide ? 15px : 13.5px;
        height: root.wide ? 15px : 13.5px;
        color: area.has-hover && root.is-close ? #ffffff
            : area.has-hover ? Theme.text
            : Theme.text-dim;
        opacity: (root.dimmed && !area.has-hover) ? 0.52 : 1.0;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Unified global search input hosted in the center of the custom TitleBar.
component TopSearchBar inherits Rectangle {
    in-out property <string> text;
    in property <string> shortcut;
    in property <bool> enabled: true;
    in property <bool> dimmed: false;
    in property <bool> wide: false;
    out property <bool> focused: input.has-focus;
    callback edited();
    callback accepted();
    callback cleared();
    callback escaped();
    callback pressed();
    public function focus-input() {
        if root.enabled {
            input.focus();
        }
    }

    height: root.wide ? 40px : 36px;
    border-radius: root.wide ? 12px : 10px;
    background: input.has-focus ? Theme.bg : (root.enabled && bar-hover.has-hover) ? Theme.surface-hover : Theme.raised;
    border-width: 1px;
    border-color: input.has-focus ? Theme.search-focus-border : Theme.border;
    opacity: !root.enabled ? 0.45 : (root.dimmed && !input.has-focus && !bar-hover.has-hover) ? 0.72 : 1.0;

    bar-hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.text : default;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.pressed();
            }
        }
        clicked => {
            input.focus();
        }
    }

    property <length> lead-x: root.wide ? 14px : 12px;
    property <length> icon-sz: root.wide ? 18px : 16px;
    property <length> text-x: root.wide ? 42px : 36px;
    property <length> font-sz: root.wide ? 15px : 14px;

    Icon {
        x: root.lead-x;
        y: (parent.height - self.height) / 2;
        kind: IconKind.search;
        width: root.icon-sz;
        height: root.icon-sz;
        color: input.has-focus ? Theme.accent-text : Theme.text-faint;
    }

    property <length> trailing-w: root.text != "" ? (root.wide ? 40px : 34px)
        : (!input.has-focus && root.shortcut != "") ? kbd.width + 18px : 14px;

    editor-scope := FocusScope {
        x: root.text-x;
        width: max(48px, parent.width - root.text-x - root.trailing-w);
        height: parent.height;
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.escaped();
                return accept;
            }
            return e.text == Key.Tab ? reject : accept;
        }
        input := TextInput {
            width: parent.width;
            height: 100%;
            enabled: root.enabled;
            vertical-alignment: center;
            font-size: root.font-sz;
            text <=> root.text;
            color: Theme.text;
            selection-background-color: Theme.accent-dim;
            single-line: true;
            edited => {
                root.edited();
            }
            accepted => {
                root.accepted();
            }
        }
    }

    if root.text == "": Text {
        x: root.text-x;
        width: max(0px, parent.width - root.text-x - root.trailing-w);
        height: 100%;
        text: "搜索曲库、艺人、作品...";
        font-family: Fonts.family(self.text);
        color: Theme.text-faint;
        font-size: root.font-sz;
        vertical-alignment: center;
        overflow: elide;
    }

    kbd := Rectangle {
        visible: root.text == "" && !input.has-focus && root.shortcut != "";
        x: parent.width - self.width - (root.wide ? 10px : 9px);
        y: (parent.height - self.height) / 2;
        height: root.wide ? 24px : 20px;
        width: kbd-txt.preferred-width + (root.wide ? 14px : 12px);
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        kbd-txt := Text {
            text: root.shortcut;
            color: Theme.text-faint;
            font-size: root.wide ? 12px : 11px;
            font-weight: 500;
        }
    }

    if root.text != "": Rectangle {
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        width: root.wide ? 28px : 24px;
        height: root.wide ? 28px : 24px;
        border-radius: self.height / 2;
        background: clear-area.has-hover ? Theme.win-btn-hover : transparent;
        Icon {
            kind: IconKind.close;
            width: root.wide ? 14px : 12px;
            height: root.wide ? 14px : 12px;
            color: clear-area.has-hover ? Theme.text : Theme.text-faint;
        }
        clear-area := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.text = "";
                root.cleared();
                input.focus();
            }
        }
    }
}

// Integrated chrome title bar (Option D chassis): 56px on wide / 4K windows, 46px on regular.
export component TitleBar inherits Rectangle {
    in property <image> app-icon;
    in property <bool> logged-in: false;
    in property <bool> full-open: false;
    in property <bool> modal-open: false;
    in property <bool> wide: false;
    in property <bool> small: false;
    in property <bool> can-go-back: false;
    in property <string> crumb;
    in property <string> search-shortcut;
    in-out property <string> search-text;
    in property <bool> panel-open: false;
    in property <bool> window-active: true;
    in property <bool> window-maximized: false;
    in property <length> resize-inset: 0px;
    out property <bool> search-focused: top-search.focused;

    callback go-back();
    callback close-full();
    callback search-edited();
    callback search-accepted();
    callback search-cleared();
    callback search-escaped();
    callback unfocus-search();
    callback chrome-pressed();
    callback toggle-panel();
    callback window-drag();
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();

    public function focus-search() {
        top-search.focus-input();
    }

    height: root.wide ? 56px : 46px;
    background: Theme.chrome;

    property <bool> show-nav: root.logged-in && !root.full-open;
    property <bool> show-search: root.logged-in && !root.full-open;
    property <bool> show-panel-btn: root.logged-in && !root.full-open;
    property <length> nav-btn-h: root.wide ? 38px : 34px;
    property <length> nav-icon-sz: root.wide ? 20px : 18px;
    property <length> panel-btn-w: root.wide ? 44px : 38px;
    property <length> caption-total-w: root.wide ? 168px : 144px;
    property <length> panel-gap: root.wide ? 10px : 8px;
    property <length> right-w: (root.show-panel-btn ? (root.panel-btn-w + 2 * root.panel-gap + 1px) : 0px) + root.caption-total-w + root.resize-inset;
    property <length> target-search-w: root.wide ? clamp(root.width * 0.26, 480px, 720px) : 440px;
    property <length> search-w: min(root.target-search-w, max(220px, root.width - root.right-w - (root.small ? 116px : 280px)));
    property <length> search-x: clamp(root.small ? 102px : 220px, (root.width - root.search-w) / 2, root.width - root.right-w - root.search-w - 16px);
    property <length> left-max-w: root.show-search ? max(88px, root.search-x - 28px) : max(140px, root.width - root.right-w - 28px);

    // Local double-click window for `drag-area` only: avoids Slint's
    // window-wide click counter turning a nearby control click + blank click
    // into an accidental maximize.
    dbl-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
        }
    }

    // Drag & double-click maximize region behind interactive chrome controls.
    // A 4px pointer-move threshold preserves clean double-click detection
    // before handing movement over to winit's OS drag loop.
    drag-area := TouchArea {
        property <bool> press-active: false;
        property <bool> drag-started: false;
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <length> last-click-x: 0px;
        property <length> last-click-y: 0px;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.chrome-pressed();
                if root.search-focused {
                    root.unfocus-search();
                }
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                self.press-active = true;
                self.drag-started = false;
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                if self.press-active && !self.drag-started {
                    if dbl-timer.running
                        && abs(self.mouse-x - self.last-click-x) <= 8px
                        && abs(self.mouse-y - self.last-click-y) <= 8px
                    {
                        dbl-timer.running = false;
                        root.window-toggle-maximize();
                    } else {
                        self.last-click-x = self.mouse-x;
                        self.last-click-y = self.mouse-y;
                        dbl-timer.restart();
                    }
                }
                self.press-active = false;
                self.drag-started = false;
            }
            if e.kind == PointerEventKind.cancel {
                self.press-active = false;
                self.drag-started = false;
                dbl-timer.running = false;
            }
        }
        moved => {
            if self.pressed && self.press-active && !self.drag-started {
                if abs(self.mouse-x - self.press-x) >= 4px || abs(self.mouse-y - self.press-y) >= 4px {
                    self.drag-started = true;
                    self.press-active = false;
                    dbl-timer.running = false;
                    root.window-drag();
                }
            }
        }
    }

    // Left slot: brand mark + divider + back/collapse + lightweight breadcrumb.
    left-group := HorizontalLayout {
        x: root.wide ? 20px : 16px;
        y: 0px;
        width: min(self.preferred-width, root.left-max-w);
        height: parent.height;
        spacing: root.wide ? 12px : 10px;
        alignment: start;

        Image {
            source: root.app-icon;
            width: root.wide ? 24px : 20px;
            height: root.wide ? 24px : 20px;
            y: (parent.height - self.height) / 2;
            image-fit: ImageFit.contain;
            opacity: root.window-active ? 1.0 : 0.55;
        }

        if !root.small || !root.logged-in: Text {
            text: "032player";
            color: Theme.text-dim;
            font-size: root.wide ? 15.5px : 14px;
            font-weight: 600;
            vertical-alignment: center;
            opacity: root.window-active ? 1.0 : 0.55;
        }

        if root.logged-in: Rectangle {
            width: 1px;
            height: root.wide ? 18px : 16px;
            y: (parent.height - self.height) / 2;
            background: Theme.border;
        }

        if root.show-nav: TitleNavButton {
            y: (parent.height - self.height) / 2;
            btn-width: root.nav-btn-h;
            btn-height: root.nav-btn-h;
            icon-size: root.nav-icon-sz;
            kind: IconKind.back;
            enabled: root.can-go-back && !root.modal-open;
            dimmed: !root.window-active;
            clicked => {
                root.go-back();
            }
        }

        if root.logged-in && root.full-open: TitleNavButton {
            y: (parent.height - self.height) / 2;
            btn-width: root.nav-btn-h;
            btn-height: root.nav-btn-h;
            icon-size: root.nav-icon-sz;
            kind: IconKind.chevron-down;
            enabled: !root.modal-open;
            dimmed: !root.window-active;
            clicked => {
                root.close-full();
            }
        }

        if root.logged-in && root.crumb != "" && (!root.small || root.full-open): Text {
            text: root.crumb;
            font-family: Fonts.family(self.text);
            color: Theme.text-faint;
            font-size: root.wide ? 14.5px : 13.5px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
            opacity: root.window-active ? 1.0 : 0.55;
        }
    }

    // Center slot: unified global search input.
    top-search := TopSearchBar {
        visible: root.show-search;
        enabled: !root.modal-open;
        wide: root.wide;
        x: root.search-x;
        y: (parent.height - self.height) / 2;
        width: root.search-w;
        text <=> root.search-text;
        shortcut: root.search-shortcut;
        dimmed: !root.window-active;
        edited => {
            root.search-edited();
        }
        accepted => {
            root.search-accepted();
        }
        cleared => {
            root.search-cleared();
        }
        escaped => {
            root.search-escaped();
        }
        pressed => {
            root.chrome-pressed();
        }
    }

    // Right slot: now-playing panel toggle + divider + native-style caption buttons.
    right-group := HorizontalLayout {
        x: parent.width - self.width;
        y: 0px;
        width: root.right-w;
        height: parent.height;
        spacing: 0px;
        alignment: end;

        if root.show-panel-btn: HorizontalLayout {
            padding-right: root.panel-gap;
            spacing: root.panel-gap;
            TitleNavButton {
                y: (parent.height - self.height) / 2;
                btn-width: root.panel-btn-w;
                btn-height: root.nav-btn-h;
                icon-size: root.nav-icon-sz;
                kind: IconKind.panel-right;
                enabled: !root.modal-open;
                active: root.panel-open;
                dimmed: !root.window-active;
                clicked => {
                    root.toggle-panel();
                }
            }
            Rectangle {
                width: 1px;
                height: root.wide ? 18px : 16px;
                y: (parent.height - self.height) / 2;
                background: Theme.border;
            }
        }

        HorizontalLayout {
            padding-top: root.resize-inset;
            padding-right: root.resize-inset;
            spacing: 0px;
            WinCaptionButton {
                kind: IconKind.win-min;
                dimmed: !root.window-active;
                rounded: root.resize-inset > 0px;
                wide: root.wide;
                clicked => {
                    root.window-minimize();
                }
            }
            WinCaptionButton {
                kind: root.window-maximized ? IconKind.win-restore : IconKind.win-max;
                dimmed: !root.window-active;
                rounded: root.resize-inset > 0px;
                wide: root.wide;
                clicked => {
                    root.window-toggle-maximize();
                }
            }
            WinCaptionButton {
                kind: IconKind.close;
                is-close: true;
                dimmed: !root.window-active;
                rounded: root.resize-inset > 0px;
                wide: root.wide;
                clicked => {
                    root.window-close();
                }
            }
        }
    }
}
