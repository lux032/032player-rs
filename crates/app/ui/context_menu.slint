import { ScrollView } from "std-widgets.slint";
import { Fonts, Shell, Theme } from "theme.slint";
import { Icon, IconKind } from "controls.slint";

export struct PlaylistChoice {
    id: int,
    name: string,
}

export struct ContextMenuEntry {
    // 0: action item, 1: divider, 2: playlist submenu trigger
    kind: int,
    label: string,
    icon: IconKind,
    what: string,
    arg: int,
    hidden: bool,
    disabled: bool,
    accent-icon: bool,
    danger: bool,
}

export global ContextMenuState {
    in-out property <bool> open: false;
    in-out property <length> anchor-x: 0px;
    in-out property <length> anchor-y: 0px;
    in-out property <[ContextMenuEntry]> entries: [];
    in-out property <[PlaylistChoice]> playlists: [];
    in-out property <int> next-token: 0;
    in-out property <int> active-token: 0;
    in-out property <int> fired-token: 0;
    in-out property <string> fired-what: "";
    in-out property <int> fired-arg: 0;

    public function show(x: length, y: length, entries: [ContextMenuEntry], playlists: [PlaylistChoice]) -> int {
        self.next-token += 1;
        self.active-token = self.next-token;
        self.anchor-x = x;
        self.anchor-y = y;
        self.entries = entries;
        self.playlists = playlists;
        self.open = true;
        return self.active-token;
    }

    public function trigger(what: string, arg: int) {
        self.open = false;
        self.fired-what = what;
        self.fired-arg = arg;
        self.fired-token = self.active-token;
    }

    public function close() {
        self.open = false;
    }
}

component ContextMenuRow inherits Rectangle {
    in property <string> label;
    in property <IconKind> icon;
    in property <bool> has-icon: true;
    in property <bool> enabled: true;
    in property <bool> accent-icon;
    in property <bool> danger;
    in property <bool> submenu;
    in property <bool> active;
    callback hovered(bool, length);
    callback triggered(length);

    height: 32px;
    border-radius: 6px;
    background: (root.enabled && (area.has-hover || root.active))
        ? (Theme.dark ? #ffffff0d : #0000000a)
        : transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.has-icon: Rectangle {
            width: 15px;
            Icon {
                kind: root.icon;
                width: 15px;
                height: 15px;
                color: root.danger ? Theme.danger
                    : root.accent-icon ? Theme.accent
                    : (area.has-hover || root.active) && root.enabled ? Theme.text
                    : Theme.text-dim;
            }
        }
        Text {
            text: root.label;
            font-family: Fonts.family(self.text);
            color: root.danger ? Theme.danger : Theme.text;
            font-size: 13.5px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.submenu: Rectangle {
            width: 14px;
            Icon {
                kind: IconKind.chevron-right;
                width: 14px;
                height: 14px;
                color: (area.has-hover || root.active) ? Theme.text : Theme.text-faint;
            }
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        changed has-hover => {
            root.hovered(self.has-hover, root.absolute-position.y);
        }
        clicked => {
            root.triggered(root.absolute-position.y);
        }
    }
}

export component ContextMenuOverlay inherits Rectangle {
    in property <length> top-inset: 0px;
    width: 100%;
    height: 100%;

    property <int> token: ContextMenuState.active-token;
    property <bool> sub-open: false;
    property <bool> sub-row-hovered: false;
    property <bool> sub-box-hovered: false;
    property <bool> sub-new-hovered: false;
    property <int> sub-list-hovered: -1;
    property <bool> sub-pointer-inside: root.sub-box-hovered || root.sub-new-hovered || root.sub-list-hovered >= 0;
    property <length> sub-anchor-y: 0px;

    changed token => {
        root.sub-open = false;
        root.sub-row-hovered = false;
        root.sub-box-hovered = false;
        root.sub-new-hovered = false;
        root.sub-list-hovered = -1;
        sub-close-timer.running = false;
    }

    changed sub-open => {
        if !self.sub-open {
            root.sub-box-hovered = false;
            root.sub-new-hovered = false;
            root.sub-list-hovered = -1;
        }
    }

    changed sub-pointer-inside => {
        if self.sub-pointer-inside {
            sub-close-timer.running = false;
        } else if !root.sub-row-hovered {
            sub-close-timer.running = true;
        }
    }

    sub-close-timer := Timer {
        running: false;
        interval: 160ms;
        triggered => {
            self.running = false;
            if !root.sub-row-hovered && !root.sub-pointer-inside {
                root.sub-open = false;
            }
        }
    }

    // Backdrop: click or scroll outside closes the menu.
    TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                ContextMenuState.close();
            }
        }
        scroll-event(e) => {
            ContextMenuState.close();
            return EventResult.reject;
        }
    }

    property <length> menu-w: 222px;
    property <length> menu-min-y: root.top-inset + 8px;
    property <length> menu-h: min(max(44px, Shell.window-height - root.menu-min-y - 8px), menu-col.preferred-height);
    property <length> menu-x: clamp(ContextMenuState.anchor-x, 8px, max(8px, Shell.window-width - root.menu-w - 8px));
    property <length> menu-y: clamp(ContextMenuState.anchor-y, root.menu-min-y, max(root.menu-min-y, Shell.window-height - root.menu-h - 8px));

    main-panel := Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        width: root.menu-w;
        height: root.menu-h;
        background: Theme.popover;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.popover-border;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: Theme.dark ? #00000090 : #00000024;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        menu-col := VerticalLayout {
            padding: 6px;
            spacing: 0px;
            for entry in ContextMenuState.entries: Rectangle {
                visible: !entry.hidden;
                height: entry.hidden ? 0px : entry.kind == 1 ? 7px : 32px;
                clip: entry.hidden;
                if !entry.hidden && entry.kind == 1: Rectangle {
                    x: 6px;
                    y: 3px;
                    width: parent.width - 12px;
                    height: 1px;
                    background: Theme.popover-border;
                }
                if !entry.hidden && entry.kind != 1: ContextMenuRow {
                    width: 100%;
                    height: 100%;
                    label: entry.label;
                    icon: entry.icon;
                    enabled: !entry.disabled;
                    accent-icon: entry.accent-icon;
                    danger: entry.danger;
                    submenu: entry.kind == 2;
                    active: entry.kind == 2 && root.sub-open;
                    hovered(h, abs-y) => {
                        if entry.kind == 2 {
                            root.sub-row-hovered = h;
                            if h {
                                sub-close-timer.running = false;
                                root.sub-anchor-y = abs-y - main-panel.absolute-position.y;
                                root.sub-open = true;
                            } else if !root.sub-pointer-inside {
                                sub-close-timer.running = true;
                            }
                        } else if h {
                            root.sub-row-hovered = false;
                            if !root.sub-pointer-inside {
                                root.sub-open = false;
                                sub-close-timer.running = false;
                            }
                        }
                    }
                    triggered(abs-y) => {
                        if entry.kind == 2 {
                            sub-close-timer.running = false;
                            root.sub-anchor-y = abs-y - main-panel.absolute-position.y;
                            root.sub-open = !root.sub-open;
                        } else {
                            ContextMenuState.trigger(entry.what, entry.arg);
                        }
                    }
                }
            }
        }
    }

    property <length> sub-w: 214px;
    property <length> sub-list-h: min(256px, ContextMenuState.playlists.length * 32px);
    property <length> sub-h: min(max(44px, Shell.window-height - 16px), 12px + 32px + (ContextMenuState.playlists.length > 0 ? 7px + root.sub-list-h : 0px));
    property <length> sub-x: (root.menu-x + root.menu-w + 4px + root.sub-w + 8px <= Shell.window-width)
        ? (root.menu-x + root.menu-w + 4px)
        : max(8px, root.menu-x - root.sub-w - 4px);
    property <length> sub-y: clamp(root.menu-y + root.sub-anchor-y - 6px, root.menu-min-y, max(root.menu-min-y, Shell.window-height - root.sub-h - 8px));

    if root.sub-open: Rectangle {
        x: root.sub-x;
        y: root.sub-y;
        width: root.sub-w;
        height: root.sub-h;
        background: Theme.popover;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.popover-border;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: Theme.dark ? #00000090 : #00000024;

        sub-area := TouchArea {
            width: 100%;
            height: 100%;
            changed has-hover => {
                root.sub-box-hovered = self.has-hover;
            }
        }

        VerticalLayout {
            padding: 6px;
            spacing: 0px;
            ContextMenuRow {
                label: "新建歌单…";
                icon: IconKind.plus;
                accent-icon: true;
                hovered(h, _y) => {
                    root.sub-new-hovered = h;
                }
                triggered(_y) => {
                    ContextMenuState.trigger("new-playlist", 0);
                }
            }
            if ContextMenuState.playlists.length > 0: Rectangle {
                height: 7px;
                Rectangle {
                    x: 6px;
                    y: 3px;
                    width: parent.width - 12px;
                    height: 1px;
                    background: Theme.popover-border;
                }
            }
            if ContextMenuState.playlists.length > 0: ScrollView {
                height: root.sub-list-h;
                VerticalLayout {
                    alignment: start;
                    for p[i] in ContextMenuState.playlists: ContextMenuRow {
                        label: p.name;
                        icon: IconKind.note;
                        hovered(h, _y) => {
                            if h {
                                root.sub-list-hovered = i;
                            } else if root.sub-list-hovered == i {
                                root.sub-list-hovered = -1;
                            }
                        }
                        triggered(_y) => {
                            ContextMenuState.trigger("add", p.id);
                        }
                    }
                }
            }
        }
    }
}

