import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Field, PrimaryButton, ValueBar, IconButton, IconKind, Icon } from "controls.slint";

// One row of the main pane: a card (grid layout) or a text row (list
// layout). `meta` holds the year, the counts or "album · duration".
export struct ViewRow {
    // 0 album, 1 track, 2 artist, 3 playlist: what a click opens.
    kind: int,
    id: int,
    index: int,
    title: string,
    subtitle: string,
    meta: string,
    artwork: string,
    favorite: bool,
    // Track rows start playing from their index in the view's track list.
    playable: bool,
    cover: image,
}

export struct ViewRowChunk {
    items: [ViewRow],
}

export struct Toolbar {
    // Sort labels, in menu order; the selected one is an index.
    sorts: [string],
    sort-index: int,
    // true: descending (the arrow points down).
    desc: bool,
    search: string,
    // 0..9999: a year filter is set when from > 0.
    year-from: int,
    year-to: int,
    // 1 when only favorites are listed.
    favorite: int,
    // The favorite switch and the year range apply to text lists only.
    filterable: bool,
}

export struct LyricLine {
    text: string,
}

export struct QueueRow {
    uid: int,
    title: string,
    artist: string,
    duration: string,
}

export component LoginView inherits Rectangle {
    in-out property <string> server;
    in-out property <string> api-token;
    in-out property <string> media-token;
    // A token is saved for the server: an empty field reuses it.
    in property <bool> api-token-saved;
    in property <bool> media-token-saved;
    in property <string> error;
    in property <bool> busy;
    callback login(string, string, string);
    background: Theme.bg;

    function submit() {
        if !root.busy {
            root.login(root.server, root.api-token, root.media-token);
        }
    }

    Rectangle {
        width: 420px;
        height: card.preferred-height;
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        card := VerticalLayout {
            padding: 32px;
            spacing: 18px;

            Text {
                text: "连接 032 Music Server";
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
            }

            Field {
                label: "服务器地址";
                placeholder: "https://music.example.com";
                text <=> root.server;
                accepted => {
                    root.submit();
                }
            }

            Field {
                label: "API Token";
                placeholder: root.api-token-saved ? "已保存，留空即沿用" : "";
                password: true;
                text <=> root.api-token;
                accepted => {
                    root.submit();
                }
            }

            Field {
                label: "媒体凭据";
                placeholder: root.media-token-saved ? "已保存，留空即沿用" : "";
                password: true;
                text <=> root.media-token;
                accepted => {
                    root.submit();
                }
            }

            if root.error != "": Text {
                text: root.error;
                color: Theme.danger;
                wrap: word-wrap;
            }

            PrimaryButton {
                text: root.busy ? "连接中…" : "登录";
                enabled: !root.busy;
                clicked => {
                    root.submit();
                }
            }
        }
    }
}

component RowCard inherits Rectangle {
    in property <ViewRow> data;
    in property <length> size: 168px;
    // The playlists of the "add to playlist" menu.
    in property <[string]> playlist-names;
    // Click (or a card without a detail page) starts playing.
    callback clicked();
    // The context menu's "播放": plays the album, does not open it.
    callback play();
    callback enqueue(bool);
    callback favorite(bool);
    // Playlist id, from the matching index of `playlist-names`.
    callback add-to-playlist(int);
    width: root.size;
    height: root.size + 62px;

    VerticalLayout {
        spacing: 6px;
        alignment: start;

        Rectangle {
            width: root.size;
            height: root.size;
            border-radius: Theme.radius;
            background: Theme.raised;
            clip: true;

            Image {
                source: root.data.cover;
                width: 100%;
                height: 100%;
                image-fit: ImageFit.cover;
            }

            Rectangle {
                background: area.has-hover ? #00000059 : transparent;
                animate background { duration: 120ms; }
            }

            if area.has-hover: Rectangle {
                x: parent.width - 52px;
                y: parent.height - 52px;
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: Theme.accent;
                Icon {
                    kind: IconKind.play;
                    width: 16px;
                    height: 16px;
                    color: #ffffff;
                }
            }

            if root.data.favorite: Rectangle {
                x: parent.width - 26px;
                y: 10px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Theme.danger;
            }
        }

        Text {
            text: root.data.title;
            color: Theme.text;
            font-weight: 600;
            overflow: elide;
            width: root.size;
        }

        Text {
            text: root.data.meta == "" ? root.data.subtitle : root.data.subtitle + " · " + root.data.meta;
            color: Theme.text-dim;
            font-size: 12px;
            overflow: elide;
            width: root.size;
        }
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "播放";
                activated => {
                    root.play();
                }
            }
            MenuItem {
                title: "下一首播放";
                activated => {
                    root.enqueue(true);
                }
            }
            MenuItem {
                title: "添加到队列末尾";
                activated => {
                    root.enqueue(false);
                }
            }
            MenuItem {
                title: root.data.favorite ? "取消收藏" : "收藏";
                activated => {
                    root.favorite(!root.data.favorite);
                }
            }
            if root.playlist-names.length > 0: Menu {
                title: "添加到歌单";
                for name[i] in root.playlist-names: MenuItem {
                    title: name;
                    activated => {
                        root.add-to-playlist(i);
                    }
                }
            }
        }

        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
}

// A text row: artwork thumbnail when the row has one, then title /
// subtitle / meta.
component RowLine inherits Rectangle {
    in property <ViewRow> data;
    // The rows can be removed and reordered (playlist editor).
    in property <bool> editable;
    in property <[string]> playlist-names;
    callback clicked();
    callback play();
    callback enqueue(bool);
    callback favorite(bool);
    callback remove();
    callback add-to-playlist(int);
    // Playlist editing: move the row one place, or drag it.
    callback move-by(int);
    callback moved-to(int);
    // Show the similar tracks of this row.
    callback similar();
    height: 40px;
    background: row-area.has-hover ? Theme.surface-hover : transparent;

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: 12px;

        Text {
            text: data.playable ? (data.index + 1) : "";
            width: 40px;
            color: Theme.text-faint;
            vertical-alignment: center;
        }

        if data.artwork != "" || data.playable: Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: Theme.raised;
            clip: true;
            Image {
                source: data.cover;
                width: 100%;
                height: 100%;
                image-fit: ImageFit.cover;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: data.title;
                color: Theme.text;
                overflow: elide;
            }
            if data.subtitle != "": Text {
                text: data.subtitle;
                color: Theme.text-dim;
                font-size: 11px;
                overflow: elide;
            }
        }

        Text {
            text: data.meta;
            color: Theme.text-dim;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            width: editable ? 200px : 260px;
        }

        if data.favorite: Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.danger;
            y: (parent.height - self.height) / 2;
        }

        if row-area.has-hover: Rectangle {
            width: 28px;
            remove-icon := Icon {
                kind: IconKind.close;
                width: 14px;
                height: 14px;
                color: remove-area.has-hover ? Theme.text : Theme.text-faint;
            }
            remove-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.remove();
                }
            }
        }
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "播放";
                activated => {
                    root.play();
                }
            }
            MenuItem {
                title: "下一首播放";
                activated => {
                    root.enqueue(true);
                }
            }
            MenuItem {
                title: "添加到队列末尾";
                activated => {
                    root.enqueue(false);
                }
            }
            MenuItem {
                title: data.favorite ? "取消收藏" : "收藏";
                activated => {
                    root.favorite(!data.favorite);
                }
            }
            if root.editable: MenuItem {
                title: "从歌单移除";
                activated => {
                    root.remove();
                }
            }
            if root.data.playable: MenuItem {
                title: "相似歌曲";
                activated => {
                    root.similar();
                }
            }
            if root.editable: MenuItem {
                title: "上移";
                activated => {
                    root.move-by(-1);
                }
            }
            if root.editable: MenuItem {
                title: "下移";
                activated => {
                    root.move-by(1);
                }
            }
            if root.playlist-names.length > 0: Menu {
                title: "添加到歌单";
                for name[i] in root.playlist-names: MenuItem {
                    title: name;
                    activated => {
                        root.add-to-playlist(i);
                    }
                }
            }
        }

    }

    // Drag to reorder: the pointer travel in whole rows decides the target.
    // A plain click stays a double-click for playback.
    in property <length> row-height: 40px;
    property <length> drag-from: 0px;
    property <length> drag-last: 0px;
    row-area := TouchArea {
        double-clicked => {
            root.clicked();
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.drag-from = self.mouse-y;
                root.drag-last = self.mouse-y;
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                if root.editable && abs(root.drag-last - root.drag-from) > 8px {
                    root.moved-to(root.data.index + round((root.drag-last - root.drag-from) / root.row-height));
                }
            }
        }
        moved => {
            if self.pressed {
                root.drag-last = self.mouse-y;
            }
        }
    }
}

// The toolbar above a list: sort menu with direction, and a search box.
component ViewToolbar inherits Rectangle {
    in-out property <Toolbar> toolbar;
    callback sort-picked(int);
    callback direction-toggled();
    callback search-submitted(string);
    callback year-range(int, int);
    callback favorite-toggled(bool);
    // A detail page has nothing to sort or search: keep the row empty.
    height: root.toolbar.sorts.length == 0 && !root.toolbar.filterable ? 0px : 44px;
    visible: root.height > 0px;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        if root.toolbar.sorts.length > 0: Rectangle {
            height: 32px;
            width: sort-content.preferred-width + 24px;
            border-radius: Theme.radius;
            background: sort-area.has-hover ? Theme.surface-hover : Theme.raised;

            sort-content := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                Text {
                    text: root.toolbar.sort-index >= 0 && root.toolbar.sort-index < root.toolbar.sorts.length
                        ? root.toolbar.sorts[root.toolbar.sort-index] : "排序";
                    color: Theme.text;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.toolbar.desc ? "↓" : "↑";
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            sort-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    sort-menu.show();
                }
            }
        }

        if root.toolbar.filterable: Rectangle {
            height: 32px;
            width: 72px;
            border-radius: Theme.radius;
            background: root.toolbar.favorite != 0 ? Theme.accent-dim : fav-area.has-hover ? Theme.surface-hover : transparent;
            Text {
                text: "仅收藏";
                color: root.toolbar.favorite != 0 ? Theme.accent : Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            fav-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.favorite-toggled(root.toolbar.favorite == 0);
                }
            }
        }

        if root.toolbar.filterable: HorizontalLayout {
            height: 32px;
            spacing: 0px;
            Text {
                text: "年份";
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
                width: 40px;
            }
            Rectangle {
                width: 56px;
                height: 32px;
                border-radius: Theme.radius;
                background: Theme.raised;
                border-width: 1px;
                border-color: year-from.has-focus ? Theme.accent : Theme.border;
                year-from := TextInput {
                    x: 4px;
                    width: parent.width - 8px;
                    height: 100%;
                    vertical-alignment: center;
                    text: root.toolbar.year-from > 0 ? root.toolbar.year-from : "";
                    color: Theme.text;
                    font-size: 12px;
                    horizontal-alignment: center;
                    single-line: true;
                    input-type: InputType.number;
                    accepted => {
                        root.year-range(self.text.to-float(), root.toolbar.year-to);
                    }
                }
            }
            Text {
                text: "–";
                color: Theme.text-faint;
                font-size: 12px;
                vertical-alignment: center;
                width: 16px;
                horizontal-alignment: center;
            }
            Rectangle {
                width: 56px;
                height: 32px;
                border-radius: Theme.radius;
                background: Theme.raised;
                border-width: 1px;
                border-color: year-to.has-focus ? Theme.accent : Theme.border;
                year-to := TextInput {
                    x: 4px;
                    width: parent.width - 8px;
                    height: 100%;
                    vertical-alignment: center;
                    text: root.toolbar.year-to > 0 ? root.toolbar.year-to : "";
                    color: Theme.text;
                    font-size: 12px;
                    horizontal-alignment: center;
                    single-line: true;
                    input-type: InputType.number;
                    accepted => {
                        root.year-range(root.toolbar.year-from, self.text.to-float());
                    }
                }
            }
        }

        if root.toolbar.sorts.length > 0: Rectangle {
            height: 32px;
            width: 52px;
            border-radius: Theme.radius;
            background: dir-area.has-hover ? Theme.surface-hover : transparent;
            Text {
                text: "反向";
                color: Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            dir-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.direction-toggled();
                }
            }
        }

        if root.toolbar.filterable: Rectangle {
            height: 32px;
            width: 240px;
            border-radius: Theme.radius;
            background: Theme.raised;
            border-width: 1px;
            border-color: search-input.has-focus ? Theme.accent : Theme.border;

            search-input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: 100%;
                vertical-alignment: center;
                text <=> root.toolbar.search;
                color: Theme.text;
                single-line: true;
                input-type: InputType.text;
                accepted => {
                    root.search-submitted(self.text);
                }
            }
            if root.toolbar.search == "": Text {
                x: 10px;
                text: "按回车搜索曲库";
                color: Theme.text-faint;
                font-size: 12px;
                vertical-alignment: center;
                height: 100%;
            }
        }
    }

    sort-menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 180px;
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                for name[i] in root.toolbar.sorts: Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: item-area.has-hover ? Theme.surface-hover : transparent;
                    Text {
                        x: 10px;
                        text: name;
                        color: i == root.toolbar.sort-index ? Theme.accent : Theme.text;
                        vertical-alignment: center;
                        height: 100%;
                    }
                    item-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            sort-menu.close();
                            root.sort-picked(i);
                        }
                    }
                }
            }
        }
    }
}

export component ViewPane inherits Rectangle {
    // Grid rows (albums) or text rows (tracks, artists, playlists).
    in property <bool> grid;
    in property <[ViewRowChunk]> rows;
    in property <[ViewRow]> lines;
    in property <string> title;
    in property <string> subtitle;
    // Joined with " · " by the app.
    in property <string> details;
    in property <image> cover;
    in property <bool> has-cover;
    in property <int> loaded;
    in property <int> total;
    in property <Toolbar> toolbar;
    // The rows can be played as a whole.
    in property <bool> can-play;
    // The playlist editor is open: rows can be removed.
    in property <bool> editable;
    // Show the whole-library random play button.
    in property <bool> shuffle-all-visible;
    // The first page failed: everything else is a retry button.
    in property <bool> load-failed;

    callback layout-changed(int, length);
    // Clicking a row: opens albums / artists / playlists, plays tracks.
    callback row-clicked(int);
    // The row's "播放": always plays (an album plays whole).
    callback row-play(int);
    callback row-enqueue(int, bool);
    callback row-favorite(int, bool);
    callback row-remove(int);
    callback row-add-to-playlist(int, int);
    // Playlist editing: move row `from` to row `to`.
    callback row-moved(int, int);
    callback row-similar(int);
    in property <[string]> playlist-names;
    callback play-all();
    callback enqueue-all(bool);
    // Whole-library random play.
    callback shuffle-all();
    callback sort-picked(int);
    callback direction-toggled();
    callback search-submitted(string);
    callback year-range(int, int);
    callback favorite-toggled(bool);
    // Scrolled near the end: ask for the next page.
    callback load-more();

    out property <int> columns: max(1, floor((self.width - 64px + 24px) / 184px));
    out property <length> card-size: (self.width - 64px - (root.columns - 1) * 24px) / root.columns;
    changed card-size => {
        root.layout-changed(root.columns, root.card-size);
    }
    init => {
        root.layout-changed(root.columns, root.card-size);
    }

    VerticalLayout {
        // Header.
        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 20px;
            padding-bottom: 8px;
            spacing: 12px;
            alignment: start;

            if root.has-cover: Rectangle {
                width: 112px;
                height: 112px;
                border-radius: Theme.radius;
                background: Theme.raised;
                clip: true;
                Image {
                    source: root.cover;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.cover;
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 4px;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 700;
                    overflow: elide;
                }
                if root.subtitle != "": Text {
                    text: root.subtitle;
                    color: Theme.text-dim;
                    font-size: 13px;
                    overflow: elide;
                }
                if root.details != "": Text {
                    text: root.details;
                    color: Theme.text-faint;
                    font-size: 12px;
                    overflow: elide;
                }
                Text {
                    text: root.total == 0 ? "" : root.loaded < root.total ? root.loaded + " / " + root.total : root.total + (root.grid ? " 张" : " 首");
                    color: Theme.text-faint;
                    font-size: 12px;
                }
            }

            if root.can-play: Rectangle {
                height: 36px;
                width: 92px;
                y: (parent.height - self.height) / 2;
                border-radius: 18px;
                background: play-area.pressed ? Theme.accent.darker(20%) : play-area.has-hover ? Theme.accent.brighter(10%) : Theme.accent;
                Text {
                    text: "播放全部";
                    color: #ffffff;
                    font-weight: 600;
                    font-size: 12px;
                }
                play-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.play-all();
                    }
                }
            }

            if root.shuffle-all-visible: Rectangle {
                height: 36px;
                width: 96px;
                y: (parent.height - self.height) / 2;
                border-radius: 18px;
                background: shuffle-area.has-hover ? Theme.surface-hover : Theme.raised;
                Text {
                    text: "随机全部";
                    color: Theme.text;
                    font-weight: 600;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                shuffle-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.shuffle-all();
                    }
                }
            }
        }

        ViewToolbar {
            x: 32px;
            width: parent.width - 64px;
            toolbar: root.toolbar;
            sort-picked(i) => {
                root.sort-picked(i);
            }
            direction-toggled => {
                root.direction-toggled();
            }
            search-submitted(text) => {
                root.search-submitted(text);
            }
            year-range(from, to) => {
                root.year-range(from, to);
            }
            favorite-toggled(on) => {
                root.favorite-toggled(on);
            }
        }

        if root.load-failed: Rectangle {
            height: 120px;
            Text {
                text: "加载失败：点此重试";
                color: Theme.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
                retry-area := TouchArea {
                    clicked => {
                        root.load-more();
                    }
                }
            }
        }

        // Grid of cards.
        if root.grid && !root.load-failed: list := ListView {
            for row in root.rows: HorizontalLayout {
                padding-left: 32px;
                padding-right: 32px;
                spacing: 24px;
                alignment: start;
                height: root.card-size + 86px;
                for card in row.items: RowCard {
                    data: card;
                    size: root.card-size;
                    playlist-names: root.playlist-names;
                    clicked => {
                        root.row-clicked(card.index);
                    }
                    play => {
                        root.row-play(card.index);
                    }
                    enqueue(next) => {
                        root.row-enqueue(card.index, next);
                    }
                    favorite(on) => {
                        root.row-favorite(card.index, on);
                    }
                    add-to-playlist(i) => {
                        root.row-add-to-playlist(card.index, i);
                    }
                }
            }
            // Scrolling near the end asks for more rows.
            scrolled => {
                if list.content-y + list.height > list.content-height - 800px {
                    root.load-more();
                }
            }
        }

        // Text rows.
        if !root.grid && !root.load-failed: lines := ListView {
            for row in root.lines: RowLine {
                data: row;
                editable: root.editable;
                playlist-names: root.playlist-names;
                clicked => {
                    root.row-clicked(row.index);
                }
                play => {
                    root.row-play(row.index);
                }
                enqueue(next) => {
                    root.row-enqueue(row.index, next);
                }
                favorite(on) => {
                    root.row-favorite(row.index, on);
                }
                remove => {
                    root.row-remove(row.index);
                }
                add-to-playlist(i) => {
                    root.row-add-to-playlist(row.index, i);
                }
                move-by(delta) => {
                    root.row-moved(row.index, row.index + delta);
                }
                moved-to(target) => {
                    root.row-moved(row.index, target);
                }
                similar => {
                    root.row-similar(row.index);
                }
            }
            scrolled => {
                if lines.content-y + lines.height > lines.content-height - 800px {
                    root.load-more();
                }
            }
        }
    }
}

export component QueuePanel inherits Rectangle {
    in property <[QueueRow]> rows;
    in property <int> current: -1;
    callback play(int);
    callback remove(int);
    callback clear();
    background: Theme.surface;

    VerticalLayout {
        HorizontalLayout {
            padding: 16px;
            spacing: 8px;
            Text {
                text: "播放队列";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: root.rows.length == 0 ? "" : root.rows.length + " 首";
                color: Theme.text-faint;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.rows.length > 0: Text {
                text: "清空";
                color: clear-area.has-hover ? Theme.text : Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
                clear-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.clear();
                    }
                }
            }
        }

        if root.rows.length == 0: Rectangle {
            Text {
                text: "队列为空";
                color: Theme.text-faint;
            }
        }

        if root.rows.length > 0: ListView {
            for row[i] in root.rows: Rectangle {
                height: 48px;
                background: i == root.current ? Theme.accent-dim : area.has-hover ? Theme.surface-hover : transparent;

                area := TouchArea {
                    double-clicked => {
                        root.play(row.uid);
                    }
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: row.title;
                            color: i == root.current ? Theme.accent : Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: row.artist;
                            color: Theme.text-dim;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: row.duration;
                        color: Theme.text-faint;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 28px;
                        remove-icon := Icon {
                            visible: area.has-hover || remove-area.has-hover;
                            kind: IconKind.close;
                            width: 14px;
                            height: 14px;
                            color: remove-area.has-hover ? Theme.text : Theme.text-faint;
                        }
                        remove-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.remove(row.uid);
                            }
                        }
                    }
                }
            }
        }
    }
}

export component LyricsPanel inherits Rectangle {
    in property <[LyricLine]> lines;
    in property <int> active: -1;
    in property <bool> synced;
    in property <string> source;
    property <length> line-height: 40px;
    background: Theme.surface;

    VerticalLayout {
        HorizontalLayout {
            padding: 16px;
            Text {
                text: "歌词";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: root.source;
                color: Theme.text-faint;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        if root.lines.length == 0: Rectangle {
            Text {
                text: "暂无歌词";
                color: Theme.text-faint;
            }
        }

        // Synced: auto-scroll only in M0 (user scrolling would break the binding).
        if root.lines.length > 0 && root.synced: synced-flick := Flickable {
            interactive: false;
            property <length> pad: max(0px, (self.height - root.line-height) / 2);
            content-height: root.lines.length * root.line-height + 2 * self.pad;
            content-y: -(max(0, root.active) * root.line-height);
            animate content-y { duration: 380ms; easing: ease-out; }

            for line[i] in root.lines: Text {
                x: 16px;
                y: synced-flick.pad + i * root.line-height;
                width: synced-flick.width - 32px;
                height: root.line-height;
                text: line.text;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: center;
                font-size: i == root.active ? 18px : 15px;
                font-weight: i == root.active ? 700 : 400;
                color: i == root.active ? Theme.text : Theme.text-faint;
                animate color { duration: 200ms; }
            }
        }

        // Plain lyrics: free scrolling.
        if root.lines.length > 0 && !root.synced: plain-flick := Flickable {
            content-height: root.lines.length * root.line-height + 32px;
            for line[i] in root.lines: Text {
                x: 16px;
                y: 16px + i * root.line-height;
                width: plain-flick.width - 32px;
                height: root.line-height;
                text: line.text;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: center;
                font-size: 15px;
                color: Theme.text-dim;
            }
        }
    }
}

export component PlayerBar inherits Rectangle {
    in property <bool> has-track;
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <string> quality;
    in property <image> cover;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <string> position-text;
    in property <string> duration-text;
    in property <bool> paused: true;
    in property <bool> buffering;
    in property <float> volume: 100;
    in property <bool> lyrics-open;
    in property <bool> queue-open;
    in property <bool> shuffle;
    // 0 off, 1 all, 2 one.
    in property <int> repeat;
    in property <bool> sleep-active;
    // Remaining time or the mode, next to the button.
    in property <string> sleep-label;
    // (0 off, 1 end of track, 2 end of album, 3 minutes; minutes)
    callback set-sleep(int, int);
    callback toggle-pause();
    callback toggle-queue();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback next();
    callback previous();
    callback seek(int);
    callback volume-changed(float);
    callback toggle-lyrics();
    height: 84px;
    background: Theme.surface;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;

        // Now playing.
        HorizontalLayout {
            width: 30%;
            spacing: 12px;
            alignment: start;
            Rectangle {
                width: 56px;
                height: 56px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: Theme.raised;
                clip: true;
                Image {
                    source: root.cover;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.cover;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.has-track ? root.title : "未在播放";
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.artist;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
                Text {
                    text: root.quality;
                    visible: root.quality != "";
                    color: Theme.accent;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }

        // Transport + progress.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                IconButton {
                    kind: IconKind.shuffle;
                    active: root.shuffle;
                    icon-size: 20px;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.toggle-shuffle();
                    }
                }
                IconButton {
                    kind: IconKind.previous;
                    enabled: root.has-track;
                    clicked => {
                        root.previous();
                    }
                }
                IconButton {
                    kind: root.paused ? IconKind.play : IconKind.pause;
                    filled: true;
                    size: 40px;
                    enabled: root.has-track;
                    clicked => {
                        root.toggle-pause();
                    }
                }
                IconButton {
                    kind: IconKind.next;
                    enabled: root.has-track;
                    clicked => {
                        root.next();
                    }
                }
                IconButton {
                    kind: IconKind.repeat;
                    badge: root.repeat == 2 ? "1" : "";
                    active: root.repeat != 0;
                    icon-size: 20px;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.cycle-repeat();
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: seek-bar.dragging ? root.preview-text : root.position-text;
                    width: 48px;
                    color: Theme.text-dim;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                seek-bar := ValueBar {
                    enabled: root.has-track && root.duration-ms > 0;
                    value: root.duration-ms > 0 ? root.position-ms / root.duration-ms : 0;
                    live(v) => {
                        root.preview-ms = v * root.duration-ms;
                    }
                    committed(v) => {
                        root.seek(v * root.duration-ms);
                    }
                }
                Text {
                    text: root.buffering ? "缓冲中" : root.duration-text;
                    width: 48px;
                    color: Theme.text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        // Sleep timer, queue, lyrics, volume.
        HorizontalLayout {
            width: 30%;
            alignment: end;
            spacing: 12px;
            HorizontalLayout {
                spacing: 2px;
                sleep-button := IconButton {
                    kind: IconKind.sleep;
                    active: root.sleep-active;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        sleep-menu.show();
                    }
                }
                if root.sleep-active: Text {
                    text: root.sleep-label;
                    color: Theme.accent;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
            IconButton {
                kind: IconKind.queue;
                active: root.queue-open;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.toggle-queue();
                }
            }
            IconButton {
                kind: IconKind.lyrics;
                active: root.lyrics-open;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.toggle-lyrics();
                }
            }
            ValueBar {
                width: 120px;
                y: (parent.height - self.height) / 2;
                value: root.volume / 100;
                live(v) => {
                    root.volume-changed(v * 100);
                }
                committed(v) => {
                    root.volume-changed(v * 100);
                }
            }
        }
    }

    sleep-menu := PopupWindow {
        x: root.width - 380px;
        y: -self.height - 8px;
        width: 180px;
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                Text {
                    text: "睡眠定时";
                    color: Theme.text-faint;
                    font-size: 11px;
                    height: 24px;
                    vertical-alignment: center;
                    x: 10px;
                }
                for option in [
                    { label: "本曲结束后", mode: 1, minutes: 0 },
                    { label: "本专辑结束后", mode: 2, minutes: 0 },
                    { label: "5 分钟", mode: 3, minutes: 5 },
                    { label: "10 分钟", mode: 3, minutes: 10 },
                    { label: "15 分钟", mode: 3, minutes: 15 },
                    { label: "30 分钟", mode: 3, minutes: 30 },
                    { label: "45 分钟", mode: 3, minutes: 45 },
                    { label: "1 小时", mode: 3, minutes: 60 },
                    { label: "2 小时", mode: 3, minutes: 120 },
                    { label: "3 小时", mode: 3, minutes: 180 },
                    { label: "4 小时", mode: 3, minutes: 240 },
                    { label: "关闭定时", mode: 0, minutes: 0 },
                ]: Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    visible: option.mode != 0 || root.sleep-active;
                    background: item-area.has-hover ? Theme.surface-hover : transparent;
                    Text {
                        x: 10px;
                        text: option.label;
                        color: Theme.text;
                        vertical-alignment: center;
                        height: 100%;
                    }
                    item-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.set-sleep(option.mode, option.minutes);
                        }
                    }
                }
            }
        }
    }

    // Seek preview while dragging.
    property <int> preview-ms;
    property <string> preview-text: floor(root.preview-ms / 60000) + ":" + (mod(floor(root.preview-ms / 1000), 60) < 10 ? "0" : "") + mod(floor(root.preview-ms / 1000), 60);
}
